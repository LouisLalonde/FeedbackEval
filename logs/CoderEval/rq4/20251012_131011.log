<repaired_code>
def normalize_cmd(cmd: tuple[str, ...]) -> tuple[str, ...]:
    if not cmd:
        return cmd

    # Handle shebang normalization for Windows
    cmd_str = cmd[0]
    if cmd_str.startswith('#!'):
        cmd_str = cmd_str[2:].strip()
        if cmd_str:
            exe = parse_filename(cmd_str.split()[0])
            rest = cmd_str.split()[1:]
            normalized_exe = normexe(exe)
            return (normalized_exe,) + tuple(rest) + cmd[1:]
    
    # Normalize the executable path
    normalized_first = normexe(cmd[0])
    if normalized_first != cmd[0]:
        return (normalized_first,) + cmd[1:]
    
    return cmd
</repaired_code>

This corrected version:

