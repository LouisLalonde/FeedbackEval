def is_local(host):
    import socket
    
    # Standard localhost identifiers
    localhost = ['localhost', '127.0.0.1', '::1']
    
    try:
        # Get the local hostname
        local_hostname = socket.gethostname()
        
        # Get all IP addresses for local hostname
        local_ips = []
        try:
            local_ips = [ip for ip in socket.gethostbyname_ex(local_hostname)[2]]
        except socket.gaierror:
            pass
        
        # Get the FQDN
        try:
            fqdn = socket.getfqdn()
        except:
            fqdn = local_hostname
            
        # Check if host matches any local identifiers
        if (host in localhost or 
            host == local_hostname or 
            host == fqdn or
            host in local_ips):
            return True
            
        # Try to resolve the host to check if it points to localhost
        try:
            host_ip = socket.gethostbyname(host)
            if host_ip in ['127.0.0.1', '::1'] or host_ip in local_ips:
                return True
        except socket.gaierror:
            pass
            
        return False
        
    except:
        # If any error occurs during hostname resolution, fall back to basic checks
        return host in localhost
</repaired_code>

