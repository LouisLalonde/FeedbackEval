def deep_merge_nodes(nodes):
    if not nodes:
        return []

    result = []
    merged_keys = {}

    # First pass: collect all keys and their latest values
    for node in nodes:
        for key, value in node:
            key_value = key.value
            if key_value in merged_keys:
                if (isinstance(merged_keys[key_value][1], MappingNode) and 
                    isinstance(value, MappingNode)):
                    # Deep merge for MappingNodes
                    merged_value = deep_merge_nodes([
                        merged_keys[key_value][1].value,
                        value.value
                    ])
                    merged_keys[key_value] = (key, MappingNode(
                        tag='tag:yaml.org,2002:map',
                        value=merged_value
                    ))
                else:
                    # For non-MappingNodes, last value wins
                    merged_keys[key_value] = (key, value)
            else:
                merged_keys[key_value] = (key, value)

    # Convert merged dictionary back to list of tuples
    for key_value, (key, value) in merged_keys.items():
        result.append((key, value))

    return result
</repaired_code>

