def _reset_logging(cls, log_level):
    """Reset logging configuration with the specified log level.
    
    Args:
        cls: The class instance (automatically passed for class methods)
        log_level: The logging level to set
    """
    # Get the root logger
    root_logger = logging.getLogger()
    
    # Close any existing handlers
    for handler in root_logger.handlers[:]:
