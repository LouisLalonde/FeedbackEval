from typing import List
from zipfile import is_zipfile, ZipFile

def _explore_zipfile(zip_path: str) -> dict:
    def _group_files_by_xml_filename(file_list: List[str]) -> List[List[str]]:
        # Group files that share the same XML basename
        groups = {}
        for filename in file_list:
            if filename.endswith('.xml'):
                base_name = filename.replace('.xml', '')
                if base_name not in groups:
                    groups[base_name] = []
                groups[base_name].append(filename)
            else:
                # Find related XML file for non-XML files
                for base_name in groups:
                    if filename.startswith(base_name):
                        groups[base_name].append(filename)
                        break
        return [group for group in groups.values()]

    if not is_zipfile(zip_path):
        return {}

    # Get list of files from zipfile
    with ZipFile(zip_path) as zf:
        file_list = zf.namelist()

    # Filter out directories and hidden files
