def check_digests_present_and_used(self, manifest_files: list[str], digests_used: list[str]) -> None:
    """
    Check all digests in manifest that are needed are present and used.

    Args:
        manifest_files (list[str]): List of digest files in manifest
        digests_used (list[str]): List of digests that are actually used

    Returns:
        None: Sets error state if there are unused or missing digests
    """
    # Convert lists to sets for easier comparison
    manifest_set = set(manifest_files)
    used_set = set(digests_used)

    # Check for digests in manifest that aren't used
    unused_digests = manifest_set.difference(used_set)
    if len(unused_digests) > 0:
        self.error("Digests in manifest but not used: " + ", ".join(sorted(unused_digests)))

    # Check for digests used but not in manifest
    missing_digests = used_set.difference(manifest_set)
    if len(missing_digests) > 0:
        self.error("Digests used but not in manifest: " + ", ".join(sorted(missing_digests)))
</repaired_code>

