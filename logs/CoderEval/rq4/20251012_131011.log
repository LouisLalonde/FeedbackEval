from typing import Dict
import json
import logging

def parse_diaspora_webfinger(document: str) -> Dict:
    try:
        # Try parsing as JSON first (new format)
        data = json.loads(document)
        for link in data.get('links', []):
            if link.get('rel') == 'http://microformats.org/profile/hcard':
                return {'hcard_url': link['href']}
    except json.JSONDecodeError:
        # If JSON parsing fails, try XRD format (old)
        try:
            from federation.utils.xrd import parse_xrd
            xrd = parse_xrd(document)
            hcard_url = find_link(xrd, 'http://microformats.org/profile/hcard')
            if hcard_url:
                return {'hcard_url': hcard_url}
        except Exception as ex:
            logger.warning("Failed to parse XRD format webfinger: %s", ex)
    
    # Return empty dict if no hcard URL found
    return {'hcard_url': ''}
