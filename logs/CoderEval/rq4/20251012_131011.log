def load_configurations(config_filenames, overrides=None, resolve_env=True):
    """
    Load and validate configuration files, returning parsed configs and error logs.
    
    Args:
        config_filenames: Sequence of configuration filenames to process
        overrides: Optional configuration overrides
        resolve_env: Whether to resolve environment variables
    
    Returns:
        Tuple of (OrderedDict of filename->config, list of error LogRecords)
    """
    from collections import OrderedDict
    import logging

    parsed_configs = OrderedDict()
    error_logs = []

    for filename in config_filenames:
        try:
            with open(filename, 'r') as file:
                config_data = parse_configuration(file)
                parsed_configs[filename] = config_data
        except (IOError, FileNotFoundError) as e:
            error_record = logging.makeLogRecord({
                'msg': 'Unable to parse configuration file {}: {}'.format(filename, str(e)),
                'levelname': 'ERROR'
            })
            error_logs.append(error_record)
        except Exception as e:
            error_record = logging.makeLogRecord({
                'msg': 'Error parsing configuration file {}: {}'.format(filename, str(e)),
                'levelname': 'ERROR'
            })
            error_logs.append(error_record)

    return parsed_configs, error_logs
