import argparse
from collections import OrderedDict

def parse_subparser_arguments(unparsed_arguments, subparsers):
    parser = argparse.ArgumentParser()
    subparser_dict = OrderedDict()
    
    # Create a single subparsers object
    main_subparsers = parser.add_subparsers(dest='command')
    
    # Set up each subparser
    for subparser_name, subparser in subparsers.items():
        # Create a new parser for this subcommand
        subparser_dict[subparser_name] = main_subparsers.add_parser(subparser_name)
        # Copy arguments from the original subparser
        for action in subparser._actions:
            if action.dest != 'help':
                subparser_dict[subparser_name].add_argument(
                    *action.option_strings,
                    **{k: v for k, v in vars(action).items() 
                       if k not in ('option_strings', '_option_string_actions')}
                )
    
    parsed_args = {}
    remaining_args = list(unparsed_arguments)
    
    # Try parsing with each subparser
    for subparser_name, subparser in subparser_dict.items():
        try:
            # Use parse_known_args to handle partial parsing
            args, unknown = subparser.parse_known_args(remaining_args)
            if vars(args).get('command') == subparser_name:
                parsed_args[subparser_name] = args
                # Remove successfully parsed arguments from remaining_args
                for arg in set(remaining_args) - set(unknown):
                    remaining_args.remove(arg)
        except (argparse.ArgumentError, SystemExit):
            continue
    
    return parsed_args, remaining_args
