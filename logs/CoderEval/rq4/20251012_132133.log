from typing import Dict
import json
from json.decoder import JSONDecodeError

def parse_diaspora_webfinger(document: str) -> Dict:
    # Try parsing as JSON first
    try:
        json_data = json.loads(document)
        # Find hcard link in JSON format
        for link in json_data.get('links', []):
            if link.get('rel') == 'http://microformats.org/profile/hcard':
                return {'hcard_url': link['href']}
    except (JSONDecodeError, AttributeError, KeyError):
        # If JSON parsing fails, try XRD format
        try:
            # Using parse_xrd from context
            xrd_data = parse_xrd(document)
            # Find hcard link in XRD format
            link = find_link(xrd_data, 'http://microformats.org/profile/hcard')
            if link:
                return {'hcard_url': link}
        except Exception as ex:
            logger.warning(f"Failed to parse webfinger document: {ex}")
    
    return {'hcard_url': ''}
</repaired_code>

