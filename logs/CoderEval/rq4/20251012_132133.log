from typing import List
from zipfile import is_zipfile, ZipFile

def _explore_zipfile(zip_path: str) -> dict:
    def _group_files_by_xml_filename(file_list: List[str]) -> List[List[str]]:
        result = {}
        for filename in file_list:
            base_name = filename.split('.')[0]  # Get base name without extension
            if base_name not in result:
                result[base_name] = []
            result[base_name].append(filename)
        return [files for files in result.values()]
    
    if not is_zipfile(zip_path):
        return {}
    
    try:
        with ZipFile(zip_path) as zf:
            # Get all files from zip
            all_files = zf.namelist()
            
            # Group files by XML basename
            grouped_files = _group_files_by_xml_filename(all_files)
            
            # Create result dictionary
            result = {}
            for group in grouped_files:
                if not group:  # Skip empty groups
                    continue
                # Use first file's basename as key
                base_name = group[0].split('.')[0]
                result[base_name] = group
                
            return result
    except Exception:
        return {}
</repaired_code>

