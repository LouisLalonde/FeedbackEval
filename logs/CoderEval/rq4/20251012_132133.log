<repaired_code>
def is_local(host):
    import socket
    
    # Standard localhost entries
    localhost = ['localhost', '127.0.0.1', '::1']
    local_domain = ['localhost.localdomain']
    
    # Check standard localhost values
    if host in localhost or host in local_domain:
        return True
        
    try:
        # Get the actual hostname of the machine
        local_hostname = socket.gethostname()
        # Get fully qualified domain name
        local_fqdn = socket.getfqdn()
        # Get all IP addresses for the local machine
        local_ips = []
        for family in [socket.AF_INET, socket.AF_INET6]:
            try:
                local_ips.extend(
                    addr[4][0] for addr in socket.getaddrinfo(
                        local_hostname, None, family, socket.SOCK_STREAM
                    )
                )
            except socket.gaierror:
                pass
                
        # Check if host matches any local identifiers
        if (host == local_hostname or 
            host == local_fqdn or 
            host in local_ips):
            return True
            
        # Try to resolve the host to check if it points to localhost
        host_ips = []
        for family in [socket.AF_INET, socket.AF_INET6]:
            try:
                host_ips.extend(
                    addr[4][0] for addr in socket.getaddrinfo(
                        host, None, family, socket.SOCK_STREAM
                    )
                )
            except socket.gaierror:
                pass
                
        # Check if any resolved IPs match local IPs
        return bool(set(host_ips) & set(local_ips))
        
    except Exception:
        # If any error occurs during hostname resolution, 
        # fall back to basic localhost check
        return host in localhost
        
    return False
</repaired_code>

