def deep_merge_nodes(nodes):
    result = {}
    
    for node in nodes:
        if not node:  # Skip empty nodes
            continue
            
        # Handle both tuple pairs and direct node access
        if isinstance(node, tuple):
            key_node, value_node = node
            key = key_node.value
        else:
            for key_node, value_node in node.value:
                key = key_node.value
                
                # If key exists and both current and new values are MappingNodes
                if (key in result and 
                    isinstance(result[key], MappingNode) and 
                    isinstance(value_node, MappingNode)):
                    # Recursively merge the mapping nodes
                    merged_value = deep_merge_nodes([
                        result[key].value,
                        value_node.value
                    ])
                    result[key] = MappingNode(
                        tag='tag:yaml.org,2002:map',
                        value=merged_value
                    )
                else:
                    # For non-mapping nodes or new keys, take the new value
                    result[key] = value_node
                    
    # Convert result back to list of tuples format
    return [(ScalarNode(tag='tag:yaml.org,2002:str', value=key), value) 
            for key, value in result.items()]
