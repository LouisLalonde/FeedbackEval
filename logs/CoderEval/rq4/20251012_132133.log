def normalize_cmd(cmd: tuple[str, ...]) -> tuple[str, ...]:
    if not cmd:
        return cmd
        
    # Normalize the executable path on Windows
    exe = normexe(cmd[0])
    
    # Parse potential shebang in the executable
    cmd_list = list(cmd)
    try:
        shebang_cmd = parse_filename(exe)
        if shebang_cmd:
            cmd_list = list(shebang_cmd) + [exe] + list(cmd[1:])
        else:
            cmd_list[0] = exe
    except OSError:
        cmd_list[0] = exe
        
    return tuple(cmd_list)
</repaired_code>

