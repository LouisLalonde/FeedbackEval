        # Copy the arguments from the original subparser
        for action in subparser_actions:
            kwargs = {
                key: getattr(action, key)
                for key in ['option_strings', 'dest', 'nargs', 'const', 'default', 
                          'type', 'choices', 'help', 'metavar']
                if hasattr(action, key) and getattr(action, key) is not None
            }
            new_parser.add_argument(*action.option_strings, **kwargs)
    
    parsed_args = {}
    remaining_args = []
    
    # Try to parse each argument with each subparser
    for arg in unparsed_arguments:
        found = False
        for subparser_name, subparser in subparsers.items():
