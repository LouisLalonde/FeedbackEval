<repaired_code>
def extostr(cls, e, max_level=30, max_path_level=5):
    """
    Format an exception with detailed traceback
    """
    try:
        # Get exception info
        if hasattr(e, '__traceback__'):
            tb = e.__traceback__
        else:
            _, _, tb = sys.exc_info()
            
        # Extract traceback
        tb_list = list(reversed(extract_tb(tb)))
        
        # Limit traceback based on max_level
        if len(tb_list) > max_level:
            tb_list = tb_list[:max_level]
            
        # Format output
        out_list = []
        out_list.append(f"Exception type: {e.__class__.__name__}")
        out_list.append(f"Exception message: {str(e)}")
        out_list.append("Traceback:")
        
        # Process each traceback entry
        for tb_entry in tb_list:
            # Format file path with max path levels
            file_path = str(tb_entry.filename)
            if max_path_level > 0:
                path_parts = file_path.rsplit('/', max_path_level)
                if len(path_parts) > max_path_level:
                    file_path = ".../" + "/".join(path_parts[-max_path_level:])
            
            # Add formatted traceback line
            line = f"  File '{file_path}', line {tb_entry.lineno}, in {tb_entry.name}"
            out_list.append(line)
            if tb_entry.line:
                out_list.append(f"    {tb_entry.line.strip()}")
                
        return "\n".join(out_list)
    except Exception as format_ex:
        # Fallback if formatting fails
        logger.warning(f"Failed to format exception: {format_ex}")
        return f"Exception({e.__class__.__name__}): {str(e)}"
</repaired_code>

