def begin(self, mode=None, bookmarks=None, metadata=None, timeout=None, db=None, imp_user=None, dehydration_hooks=None, hydration_hooks=None, **handlers):
    # Validate and set default mode
    if mode is None:
        mode = "WRITE"
    elif mode not in ("READ", "WRITE"):
        raise ValueError("Mode must be either 'READ' or 'WRITE'")

    # Validate bookmarks
    if bookmarks is not None and not isinstance(bookmarks, (list, tuple, set)):
        raise TypeError("Bookmarks must be an iterable")

    # Validate metadata
    if metadata is not None and not isinstance(metadata, dict):
        raise TypeError("Metadata must be a dictionary")

    # Validate timeout
    if timeout is not None:
        try:
            timeout = float(timeout)
            if timeout < 0:
                raise ValueError("Timeout cannot be negative")
        except (TypeError, ValueError):
            raise ValueError("Timeout must be a positive number")

    # Prepare extra arguments
    extra = {}
    if bookmarks:
        extra["bookmarks"] = list(bookmarks)
    if metadata:
        extra["metadata"] = metadata
    if timeout is not None:
        extra["timeout"] = timeout
    if db is not None:
        extra["db"] = str(db)
    if imp_user is not None:
        extra["imp_user"] = str(imp_user)
    if dehydration_hooks is not None:
        extra["dehydration_hooks"] = dehydration_hooks
    if hydration_hooks is not None:
        extra["hydration_hooks"] = hydration_hooks

    # Append BEGIN message
    self._append(b"BEGIN", extra)

    # Return Response object with handlers
    return Response(**handlers)
