def deep_merge_nodes(nodes):
    result = []
    merged_keys = {}

    for node in nodes:
        if not node:
            continue
            
        key_node, value_node = node
        key = key_node.value

        if key in merged_keys:
            # If both current and existing values are MappingNodes, merge them
            if (isinstance(value_node, MappingNode) and 
                isinstance(merged_keys[key][1], MappingNode)):
                merged_value = deep_merge_nodes(
                    merged_keys[key][1].value + value_node.value
                )
                merged_keys[key] = (key_node, MappingNode(
                    tag='tag:yaml.org,2002:map',
                    value=merged_value
                ))
            else:
                # For non-MappingNodes, last value wins
                merged_keys[key] = (key_node, value_node)
        else:
            # First occurrence of this key
            if isinstance(value_node, MappingNode):
                merged_value = deep_merge_nodes(value_node.value)
                merged_keys[key] = (key_node, MappingNode(
                    tag='tag:yaml.org,2002:map',
                    value=merged_value
                ))
            else:
                merged_keys[key] = (key_node, value_node)

    # Convert merged dictionary back to list of tuples
    for key in merged_keys:
        result.append(merged_keys[key])

    return result
</repaired_code>

