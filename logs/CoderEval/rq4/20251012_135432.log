def load_configurations(config_filenames, overrides=None, resolve_env=True):
    from collections import OrderedDict
    import logging
    
    parsed_configs = OrderedDict()
    error_logs = []

    for filename in config_filenames:
        try:
            with open(filename, 'r') as file:
                config_data = parse_configuration(file)
                parsed_configs[filename] = config_data
        except FileNotFoundError as e:
            log_record = logging.makeLogRecord({
                'msg': f"Configuration file not found: {filename}",
                'levelname': 'ERROR',
                'exc_info': e
            })
            error_logs.append(log_record)
        except IOError as e:
            log_record = logging.makeLogRecord({
                'msg': f"Error reading configuration file: {filename}",
                'levelname': 'ERROR',
                'exc_info': e
            })
            error_logs.append(log_record)
        except Exception as e:
            log_record = logging.makeLogRecord({
                'msg': f"Error parsing configuration file: {filename}",
                'levelname': 'ERROR',
                'exc_info': e
            })
            error_logs.append(log_record)

    return parsed_configs, error_logs
