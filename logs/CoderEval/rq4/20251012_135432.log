def is_local(host):
    import socket
    
    # Standard localhost patterns
    localhost = ['localhost', '127.0.0.1']
    local_ip = ['127.0.0.1', '::1']
    local_domain = ['localhost.localdomain', 'localhost']
    
    # Get the actual hostname
    try:
        actual_hostname = socket.gethostname()
        # Get all possible local hostnames
        local_hostnames = [actual_hostname]
        try:
            # Get FQDN
            fqdn = socket.getfqdn()
            if fqdn:
                local_hostnames.append(fqdn)
        except:
            pass
        
        try:
            # Get local IP addresses
            local_ips = [ip for ip in socket.gethostbyname_ex(actual_hostname)[2]]
            local_ip.extend(local_ips)
        except:
            pass
            
    except:
        local_hostnames = []
    
    # Check if host matches any local pattern
    if (host in localhost or 
        host in local_ip or 
        host in local_domain or 
        host in local_hostnames or
        host.lower() in [h.lower() for h in local_hostnames]):
        return True
        
    return False
</repaired_code>

