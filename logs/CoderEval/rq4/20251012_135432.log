from typing import List
from zipfile import ZipFile, is_zipfile

def _explore_zipfile(zip_path: str) -> List[str]:
    if not is_zipfile(zip_path):
        raise ValueError(f"Invalid zip file: {zip_path}")
        
    def _group_files_by_xml_filename(file_list: List[str]) -> List[List[str]]:
        # Group files that share the same XML basename
        groups = {}
        for filename in file_list:
            base_name = filename.split('.')[0]  # Get basename without extension
            if base_name not in groups:
                groups[base_name] = []
            groups[base_name].append(filename)
        return list(groups.values())
    
    try:
        # Get list of files from zip
        with ZipFile(zip_path) as zf:
            all_files = files_list_from_zipfile(zf)
            xml_files = xml_files_list_from_zipfile(zf)
        
        # Group files by XML basename
        grouped_files = _group_files_by_xml_filename(all_files)
        
        # Create result dictionary
        result = {}
        for xml_file in xml_files:
            base_name = xml_file.split('.')[0]
            related_files = [f for group in grouped_files if xml_file in group for f in group]
            result[base_name] = {
                'xml_file': xml_file,
                'related_files': related_files
            }
            
        return result
        
    except Exception as e:
        raise ValueError(f"Error processing zip file: {str(e)}")
