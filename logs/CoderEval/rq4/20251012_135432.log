def _resolve_string(matcher: dict) -> str:
    """
    Get the value from environment given a matcher containing a name and an optional default value.
    If the variable is not defined in environment and no default value is provided, an Error is raised.
    """
    if 'group' not in matcher:
        raise ValueError("Matcher must contain 'group' dictionary")
    
    name = matcher['group'].get('name')
    default = matcher['group'].get('default')
    
    if not name:
        raise ValueError("Environment variable name not provided in matcher")
    
    value = os.getenv(name)
    
    if value is None:
        if default is not None:
            return str(default)
        raise ValueError("Environment variable '{}' not found and no default value provided".format(name))
    
    return str(value)
</repaired_code>

