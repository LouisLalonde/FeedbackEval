def parse_subparser_arguments(unparsed_arguments, subparsers):
    parser = argparse.ArgumentParser()
    subparser_dict = {}
    
    # Create subparsers for each provided parser
    for subparser_name, subparser in subparsers.items():
        # Get the existing arguments from the subparser
        subparser_actions = [action for action in subparser._actions 
                           if not isinstance(action, argparse._SubParsersAction)]
        
        # Create a new subparser and add the arguments
        subparser_dict[subparser_name] = parser.add_subparsers(dest=subparser_name)
