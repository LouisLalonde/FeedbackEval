<repaired_code>
def check_digests_present_and_used(self, manifest_files: list[str], digests_used: list[str]) -> None:
    """
    Check all digests in manifest that are needed are present and used. Return error() in the class.
    """
    manifest_set = set(manifest_files)
    used_set = set(digests_used)
    
    # Check if there are any digests in manifest that aren't used
    unused_digests = manifest_set.difference(used_set)
    if len(unused_digests):
        self.error(f"Found digests in manifest that are not used: {', '.join(sorted(unused_digests))}")
    
    # Check if there are any used digests that aren't in the manifest
    missing_digests = used_set.difference(manifest_set)
    if len(missing_digests):
        self.error(f"Found used digests that are not in manifest: {', '.join(sorted(missing_digests))}")
</repaired_code>

