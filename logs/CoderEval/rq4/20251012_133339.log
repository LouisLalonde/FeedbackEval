def is_local(host):
    import socket
    
    localhost = ['localhost', '127.0.0.1']
    local_ip = ['127.0.0.1', '::1']
    local_domain = ['localhost.localdomain', 'localhost']
    local_username = ['root', 'admin', 'user']
    
    # Get the local hostname
    try:
        local_hostname = socket.gethostname()
        # Get all IP addresses for local hostname
        local_ips = socket.gethostbyname_ex(local_hostname)[2]
        # Add local hostname and its variations to check
        local_hostnames = [local_hostname]
        if '.' in local_hostname:
            local_hostnames.append(local_hostname.split('.')[0])
        
        # Check if host matches any local identifiers
        if (host in localhost or 
            host in local_ip or 
            host in local_domain or 
            host in local_username or
            host in local_hostnames or
            host in local_ips):
            return True
            
    except socket.error:
        # If there's an error resolving hostname, fall back to basic checks
        if host in localhost or host in local_ip or host in local_domain or host in local_username:
            return True
    
    return False
</repaired_code>

