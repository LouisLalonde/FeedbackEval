import argparse

def parse_arguments(*unparsed_arguments):
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest='subparser_name', title='subcommands', description='valid subcommands', help='additional help')
    
    # Add global arguments to main parser
    parser.add_argument('--global-option', help='Global option available to all subcommands')
    
    # Create parser for "global" arguments
    global_parser = subparsers.add_parser('global')
    global_parser.add_argument('--global-specific', help='Options specific to global command')
    
    # Create parser for subcommand1
    subcommand1_parser = subparsers.add_parser('subcommand1')
    subcommand1_parser.add_argument('--sub1-option', help='Subcommand1 specific option')
    
    # Create parser for subcommand2
    subcommand2_parser = subparsers.add_parser('subcommand2')
    subcommand2_parser.add_argument('--sub2-option', help='Subcommand2 specific option')
    
    # Parse the command-line arguments
    args = parser.parse_args(unparsed_arguments if unparsed_arguments else None)
    
    # If no subcommand is provided, show help and raise error
    if not args.subparser_name:
        parser.print_help()
        raise ValueError("No subcommand provided")
    
    # Return the parsed arguments
    return {
        'subcommand': args.subparser_name,
        'args': vars(args)
    }
</repaired_code>

