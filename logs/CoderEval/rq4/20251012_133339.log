def extostr(cls, e, max_level=30, max_path_level=5):
    try:
        # Get exception info
        exc_type, exc_value, exc_traceback = sys.exc_info()
        
        # If no exception provided, return empty
        if not e:
            return ""
            
        # Build stack trace
        stack_trace = []
        try:
            # Extract traceback info
            tb_list = extract_tb(exc_traceback)
            
            # Process each frame up to max_level
            for i, frame in enumerate(reversed(tb_list)):
                if i >= max_level:
                    break
                    
                # Get file path and limit depth
                file_path = str(frame[0])
                if max_path_level > 0:
                    path_parts = file_path.rsplit('/', max_path_level)
                    file_path = path_parts[-1] if len(path_parts) == 1 else ".../" + "/".join(path_parts[-max_path_level:])
                
                # Format frame info
                stack_entry = "File '{}', line {}, in {}".format(
                    file_path,
                    frame[1],
                    frame[2]
                )
                stack_trace.append(stack_entry)
                
                # Add code context if available
                if frame[3]:
                    stack_trace.append("  " + str(frame[3]))
            
            # Add exception type and message
            final_msg = "{}: {}".format(e.__class__.__name__, str(e))
            stack_trace.append(final_msg)
            
            return "\n".join(reversed(stack_trace))
        except Exception as ex:
            # Fallback if detailed formatting fails
            logger.warning("Error while formatting exception: %s", repr(ex))
            return str(e)
    except:
        # Ultimate fallback
        return str(e)
</repaired_code>

