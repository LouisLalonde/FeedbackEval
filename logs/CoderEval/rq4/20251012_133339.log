def process_text_links(text):
    """
    Process links in text, adding some attributes and linkifying textual links.
    """
    def _link_callback(attrs, new=False):
        # Add target="_blank" and rel="noopener" to all links
        attrs['target'] = '_blank'
        attrs['rel'] = 'noopener'
        
        # Get the href
        href = attrs.get('href', '')
        
        # Ensure links starting with http/https have proper protocol
        if not href.startswith(('http://', 'https://')):
            attrs['href'] = f'http://{href}'
            
        return attrs

    # Skip if no text
    if not text:
        return text
        
    # Create linkify callbacks
    callbacks = linkify.callbacks(callbacks={'attrs': _link_callback})
    
    # Process the text with linkify
    processed_text = linkify(text, callbacks=callbacks)
    
    return processed_text
</repaired_code>

