def process_text_links(text):
    """
    Process links in text, adding some attributes and linkifying textual links.
    """
    if not text:
        return text
    
    def link_callback(attrs, new=False):
        # Add target="_blank" and rel="noopener" to all links
        attrs['target'] = '_blank'
        attrs['rel'] = 'noopener'
        
        # If link doesn't start with http/https, add https://
        href = attrs.get('href', '')
        if href and not (href.startswith('http://') or href.startswith('https://')):
            attrs['href'] = f'https://{href}'
            
        return attrs

    # Create callbacks instance
    callbacks = callbacks()
    callbacks.get('link').append(link_callback)
    
    # Linkify the text with callbacks
    processed_text = linkify(text, callbacks=callbacks)
    
    return processed_text
