<repaired_code>
def _resolve_string(matcher: dict) -> str:
    """
    Get the value from environment given a matcher containing a name and an optional default value in its group dict.
    If the variable is not defined in environment and no default value is provided, an Error is raised.
    """
    import os

    # Get the variable name from matcher's group
    var_name = matcher['group']['name']
    
    # Check if default value is provided in the matcher
    has_default = 'default' in matcher['group']
    default_value = matcher['group'].get('default')
    
    # Get value from environment
    value = os.getenv(var_name)
    
    # If value is not in environment and no default provided, raise error
    if value is None and not has_default:
        raise ValueError('Environment variable {} not set and no default provided'.format(var_name))
    
    # Return environment value if exists, otherwise return default
    return value if value is not None else default_value
</repaired_code>

