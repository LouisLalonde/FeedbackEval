def deep_merge_nodes(nodes):
    if not nodes:
        return []
    
    result = {}
    for key_node, value_node in nodes:
        key = key_node.value
        if key in result:
            # If both current and new values are MappingNodes, merge them
            if (isinstance(result[key][1], MappingNode) and 
                isinstance(value_node, MappingNode)):
                existing_dict = dict((k.value, v) for k, v in result[key][1].value)
                new_dict = dict((k.value, v) for k, v in value_node.value)
                
                # Recursively merge the mapping nodes
                merged_items = []
                all_keys = set(existing_dict.keys()) | set(new_dict.keys())
                
                for merged_key in all_keys:
                    if merged_key in existing_dict and merged_key in new_dict:
                        if (isinstance(existing_dict[merged_key], MappingNode) and 
                            isinstance(new_dict[merged_key], MappingNode)):
                            merged_value = deep_merge_nodes([
                                (ScalarNode(tag='tag:yaml.org,2002:str', value=merged_key),
                                 existing_dict[merged_key]),
                                (ScalarNode(tag='tag:yaml.org,2002:str', value=merged_key),
                                 new_dict[merged_key])
                            ])[0][1]
                        else:
                            merged_value = new_dict[merged_key]
                    else:
                        merged_value = new_dict.get(merged_key, existing_dict.get(merged_key))
                    
                    merged_items.append(
                        (ScalarNode(tag='tag:yaml.org,2002:str', value=merged_key),
                         merged_value)
                    )
                
                result[key] = (key_node, MappingNode(tag='tag:yaml.org,2002:map', value=merged_items))
            else:
                # For non-MappingNodes, last value wins
                result[key] = (key_node, value_node)
        else:
            # Key doesn't exist, add it
            result[key] = (key_node, value_node)
    
    return [(k_node, v_node) for k_node, v_node in result.values()]
</repaired_code>

