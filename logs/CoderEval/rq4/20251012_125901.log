from typing import Dict
import json
import warnings

def parse_diaspora_webfinger(document: str) -> Dict:
    try:
        # Try parsing as JSON first (new format)
        data = json.loads(document)
        for link in data.get('links', []):
            if link.get('rel') == 'http://microformats.org/profile/hcard':
                return {'hcard_url': link['href']}
    except json.JSONDecodeError:
        # If JSON parsing fails, try XRD format (old)
        try:
            from xml.etree import ElementTree
            root = ElementTree.fromstring(document)
            for link in root.findall('{http://docs.oasis-open.org/ns/xri/xrd-1.0}Link'):
                if link.get('rel') == 'http://microformats.org/profile/hcard':
                    return {'hcard_url': link.get('href')}
        except ElementTree.ParseError:
            warnings.warn("Document is neither valid JSON nor XRD format")
    
    return {'hcard_url': None}
</repaired_code>

