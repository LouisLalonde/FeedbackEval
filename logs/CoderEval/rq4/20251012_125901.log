def normalize_cmd(cmd: tuple[str, ...]) -> tuple[str, ...]:
    """Normalize commands for Windows compatibility."""
    if not cmd:
        return cmd
        
    # Handle the first argument (executable)
    normalized = []
    exe = parse_filename(cmd[0])
    normalized.append(normexe(exe))
    
    # Add remaining arguments unchanged
    normalized.extend(cmd[1:])
    
    return tuple(normalized)
</repaired_code>

