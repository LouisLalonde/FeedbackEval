<repaired_code>
def find_roots(
    graph: "Graph", prop: "URIRef", roots: Optional[Set["Node"]] = None
) -> Set["Node"]:
    """Find the roots in some sort of transitive hierarchy."""
    # If roots not provided, get all subjects that appear as a subject of prop
    if roots is None:
        roots = set(s for s, o in graph.subject_objects(prop))
    
    # Find all nodes that appear as objects (parents) in the hierarchy
    non_roots = set(o for s, o in graph.subject_objects(prop))
    
    # Roots are those nodes that don't appear as objects (parents)
    return roots - non_roots
</repaired_code>

