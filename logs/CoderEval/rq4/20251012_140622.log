def deep_merge_nodes(nodes):
    if not nodes:
        return []

    result = {}
    for key, value in nodes[0].value:
        result[key.value] = value

    for node in nodes[1:]:
        for key, value in node.value:
            key_str = key.value
            if key_str in result:
                # If both are mapping nodes, merge them recursively
                if (isinstance(result[key_str], MappingNode) and 
                    isinstance(value, MappingNode)):
                    existing_dict = dict((k.value, v) for k, v in result[key_str].value)
                    new_dict = dict((k.value, v) for k, v in value.value)
                    merged = deep_merge_nodes([
                        MappingNode(tag='tag:yaml.org,2002:map', 
                                  value=list(existing_dict.items())),
                        MappingNode(tag='tag:yaml.org,2002:map', 
                                  value=list(new_dict.items()))
                    ])
                    result[key_str] = MappingNode(
                        tag='tag:yaml.org,2002:map',
                        value=[(ScalarNode(tag='tag:yaml.org,2002:str', value=k), v) 
                              for k, v in merged.items()]
                    )
                else:
                    # For non-mapping nodes, last value wins
                    result[key_str] = value
            else:
                result[key_str] = value

    # Convert back to list of tuples format
    return [(ScalarNode(tag='tag:yaml.org,2002:str', value=k), v) 
            for k, v in result.items()]
</repaired_code>

