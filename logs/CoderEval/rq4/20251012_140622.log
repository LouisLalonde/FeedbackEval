def normalize_cmd(cmd: tuple[str, ...]) -> tuple[str, ...]:
    """Normalize commands for Windows compatibility."""
    if not cmd:
        return cmd
        
    # Handle the first argument (executable)
    exe = parse_filename(cmd[0])
    normalized_exe = normexe(exe)
    
    # Return normalized executable with remaining arguments
    if len(cmd) > 1:
        return (normalized_exe,) + cmd[1:]
    return (normalized_exe,)
</repaired_code>

