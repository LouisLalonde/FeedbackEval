def determineMetaclass(bases, explicit_mc=None):
    """
    Determine metaclass from 1+ bases and optional explicit __metaclass__
    """
    # Start with explicit metaclass if provided
    meta = explicit_mc
    
    # If no explicit metaclass, look through bases
    if meta is None:
        if bases:
            meta = getattr(bases[0], '__class__', type(bases[0]))
            
            # Check remaining bases
            for base in bases[1:]:
                base_meta = getattr(base, '__class__', type(base))
                if issubclass(meta, base_meta):
                    continue
                if issubclass(base_meta, meta):
                    meta = base_meta
                    continue
                # Incompatible metaclasses
                raise TypeError(
                    "Incompatible metatypes in inheritance hierarchy"
                )
    
    # Default to type if no metaclass determined
    if meta is None:
        meta = type
        
    return meta
