def process_text_links(text):
    """
    Process links in text, adding some attributes and linkifying textual links.
    """
    if not text:
        return text
    
    def link_callback(attrs, new=False):
        # Add target="_blank" and rel="noopener" to all links
        attrs['target'] = '_blank'
        attrs['rel'] = 'noopener'
        return attrs

    # Initialize callbacks for link processing
    callbacks = bleach.callbacks.Callbacks()
    callbacks.add(link_callback)

    # First linkify the text to convert plain URLs to HTML links
    text = bleach.linkify(
        text,
        callbacks=callbacks,
        parse_email=True
    )

    return text
