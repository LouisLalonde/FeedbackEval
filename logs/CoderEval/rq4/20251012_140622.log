<repaired_code>
import re

def _get_resource_name_regex():
    """Build or return the regular expressions that are used to validate
    the name of the Krake resources.

    Returns:
        (re.Pattern): the compiled regular expressions, to validate
        the resource name.
    """
    # Pattern explanation:
    # ^ - start of string
    # [a-zA-Z] - must start with a letter
    # [a-zA-Z0-9-]* - followed by any number of letters, numbers, or hyphens
    # [a-zA-Z0-9] - must end with alphanumeric character (not hyphen)
    # $ - end of string
    return re.compile(r'^[a-zA-Z][a-zA-Z0-9-]*[a-zA-Z0-9]$')
</repaired_code>

