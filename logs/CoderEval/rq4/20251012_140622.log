def check_digests_present_and_used(self, manifest_files: list[str], digests_used: list[str]) -> None:
    """
    Check all digests in manifest that are needed are present and used.
    """
    manifest_set = set(manifest_files)
    digests_set = set(digests_used)
    
    # Check if there are digests in manifest not being used
    unused = manifest_set.difference(digests_set)
    if len(unused) > 0:
        self.error(f"Digests in manifest but not used: {', '.join(sorted(unused))}")
    
    # Check if there are digests being used but not in manifest
    missing = digests_set.difference(manifest_set)
    if len(missing) > 0:
        self.error(f"Digests used but not in manifest: {', '.join(sorted(missing))}")
</repaired_code>

