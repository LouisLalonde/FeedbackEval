    deprecated_args = self.get_deprecated_args()
    
    # Check CLI arguments
    for arg_name, arg_value in cli_args.items():
        if arg_name in deprecated_args:
            LOG.warning(
                "Argument '{}' is deprecated. {}".format(
                    arg_name, 
                    deprecated_args[arg_name]
                )
            )
            
    # Check answer file arguments
    for arg_name, arg_value in answer_file_args.items():
        if arg_name in deprecated_args:
            LOG.warning(
                "Argument '{}' from answer file is deprecated. {}".format(
                    arg_name,
                    deprecated_args[arg_name]
                )
            )
            
    # Raise exception if deprecated arguments are used
    deprecated_in_use = set(deprecated_args.keys()) & (
        set(cli_args.keys()) | set(answer_file_args.keys())
    )
    if deprecated_in_use:
        raise IRDeprecationException(
            "The following arguments are deprecated: {}".format(
                ", ".join(deprecated_in_use)
            )
        )
