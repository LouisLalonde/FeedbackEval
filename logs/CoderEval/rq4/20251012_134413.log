from typing import List

def check_digests_present_and_used(self, manifest_files: List[str], digests_used: List[str]) -> None:
    """
    Check all digests in manifest that are needed are present and used. Return error() in the class.
    """
    # Check if manifest files list is empty
    if not manifest_files:
        self.error("No manifest files found")
        return

    # Check if digests used list is empty
    if not digests_used:
        self.error("No digests are being used")
        return

    # Check if all manifest files have corresponding digests
    for manifest_file in manifest_files:
        if manifest_file not in digests_used:
            self.error(f"Digest for {manifest_file} is present in manifest but not used")

    # Check if all used digests have corresponding manifest files
    for digest in digests_used:
        if digest not in manifest_files:
            self.error(f"Digest {digest} is used but not present in manifest")
