import argparse

def parse_subparser_arguments(unparsed_arguments, subparsers):
    parser = argparse.ArgumentParser()
    subparser_dict = {}
    
    # Create a single subparsers object
    main_subparsers = parser.add_subparsers(dest='command')
    
    # Add each subparser to the main parser
    for subparser_name, subparser in subparsers.items():
        # Copy arguments from the provided subparser to a new subparser
        new_subparser = main_subparsers.add_parser(subparser_name)
        for action in subparser._actions:
            # Skip the default help action
            if not isinstance(action, argparse._HelpAction):
                new_subparser.add_argument(
                    *action.option_strings,
                    dest=action.dest,
                    default=action.default,
                    help=action.help,
                    type=action.type,
                    choices=action.choices,
                    required=action.required
                )
        subparser_dict[subparser_name] = new_subparser
    
    parsed_args = {}
    remaining_args = []
    
    # Try to parse each argument with each subparser
    for arg in unparsed_arguments:
        found = False
        for subparser_name, subparser in subparsers.items():
            if subparser_name in parsed_args:
                continue
            try:
                # Create a temporary parser for each attempt
                temp_parser = argparse.ArgumentParser()
                temp_subparsers = temp_parser.add_subparsers(dest='command')
                temp_subparser = temp_subparsers.add_parser(subparser_name)
                
                # Copy the arguments from the original subparser
                for action in subparser._actions:
                    if not isinstance(action, argparse._HelpAction):
                        temp_subparser.add_argument(
                            *action.option_strings,
                            dest=action.dest,
                            default=action.default,
                            help=action.help,
                            type=action.type,
                            choices=action.choices,
                            required=action.required
                        )
                
                # Try to parse the argument
                parsed = temp_parser.parse_args([subparser_name, arg])
                if parsed.command == subparser_name:
                    parsed_args[subparser_name] = parsed
                    found = True
                    break
            except (argparse.ArgumentError, SystemExit):
                continue
        
        if not found:
            remaining_args.append(arg)
    
    return parsed_args, remaining_args
