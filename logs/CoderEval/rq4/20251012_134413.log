def deep_merge_nodes(nodes):
    if not nodes:
        return []
    
    result_dict = {}
    
    # Convert nodes to a dictionary format for easier merging
    for node in nodes:
        if not isinstance(node, tuple):
            continue
            
        key_node, value_node = node
        key = key_node.value if hasattr(key_node, 'value') else str(key_node)
        
        if hasattr(value_node, 'value') and isinstance(value_node.value, list):
            # Handle MappingNode
            inner_dict = {}
            for k, v in value_node.value:
                inner_dict[k.value] = v
            
            if key in result_dict:
                # Merge with existing mapping
                existing = result_dict[key].value if hasattr(result_dict[key], 'value') else []
                existing_dict = dict((k.value, v) for k, v in existing)
                
                # Update existing dictionary with new values
                existing_dict.update(inner_dict)
                
                # Convert back to list of tuples
                value_node.value = [(type(k)(tag='tag:yaml.org,2002:str', value=k_str), v) 
                                  for k_str, v in existing_dict.items()]
                
            result_dict[key] = value_node
        else:
            # Handle scalar values
            result_dict[key] = value_node
    
    # Convert back to list of tuples format
    return [(type(key)(tag='tag:yaml.org,2002:str', value=key), value) 
            for key, value in result_dict.items()]
</repaired_code>

