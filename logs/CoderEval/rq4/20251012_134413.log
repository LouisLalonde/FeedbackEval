def _resolve_string(matcher: dict) -> str:
    """
    Get the value from environment given a matcher containing a name and an optional default value in its group dict.
    If the variable is not defined in environment and no default value is provided, an Error is raised.
    """
    import os
    
    # Get the variable name from matcher
    var_name = matcher.get('group', {}).get('name')
    if not var_name:
        raise ValueError("Variable name not provided in matcher")
    
    # Get default value if provided
    default_value = matcher.get('group', {}).get('default')
    
    # Try to get value from environment
    value = os.environ.get(var_name)
    
    # If value not in environment and no default provided, raise error
    if value is None and default_value is None:
        raise ValueError(f"Environment variable '{var_name}' not found and no default value provided")
    
    # Return environment value if found, otherwise return default
    return value if value is not None else default_value
</repaired_code>

