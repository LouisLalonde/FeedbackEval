    if not host:
        return False
        
    host = host.lower()
    localhost = ['localhost', '127.0.0.1', '::1']
    local_ip = ['127.0.0.1', '::1']
    local_domain = ['localhost.localdomain', 'localhost', '.local', '.localhost']
    
    # Check if host exactly matches any of the local patterns
    if host in localhost or host in local_ip:
        return True
        
    # Check if host ends with any of the local domain patterns
    for domain in local_domain:
        if host.endswith(domain):
