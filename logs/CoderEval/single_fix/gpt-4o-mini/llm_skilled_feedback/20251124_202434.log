        'delete', 'Deletes workspaces',
        [("name", {"nargs": '*', "help": "Workspace names"})]
    )
    delete_parser.add_argument("name").completer = completers.workspace_list

    # cleanup
    cleanup_parser = add_workspace_parser(
        'cleanup', 'Removes all the files from workspace',
        [("name", {"help": "Workspace name"})]
    )
    cleanup_parser.add_argument("name").completer = completers.workspace_list

    # import settings
    importer_parser = add_workspace_parser(
        'import', 'Import deployment configs.',
