def pop_u16(self) -> Tuple[int, int]:
    if len(self.data) < 2:
        raise IndexError("Not enough data to pop two bytes.")
    
    byte1 = self.data.pop()
    byte2 = self.data.pop()
    
    # Combine the two bytes into a big-endian 16-bit unsigned integer
    result = (byte2 << 8) | byte1
    
    return result
</repaired_code>

