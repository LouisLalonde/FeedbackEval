from typing import List, Dict
from zipfile import ZipFile, is_zipfile

def _explore_zipfile(zip_path: str) -> Dict[str, List[str]]:
    def _group_files_by_xml_filename(file_list: List[str]) -> List[List[str]]:
        # Implementation of _group_files_by_xml_filename function
        grouped_files = {}
        for file in file_list:
            basename = file.split('.')[0]  # Assuming XML files have a common basename
            if basename not in grouped_files:
                grouped_files[basename] = []
            grouped_files[basename].append(file)
        return list(grouped_files.values())
    
    if not is_zipfile(zip_path):
        raise ValueError(f"The file at {zip_path} is not a valid zip file.")
    
    with ZipFile(zip_path, 'r') as zip_file:
        file_list = zip_file.namelist()  # Get the list of files in the zip
        xml_files = [file for file in file_list if file.endswith('.xml')]  # Filter XML files
        grouped_files = _group_files_by_xml_filename(xml_files)  # Group files by XML basename
        
    return {f"Group {i+1}": group for i, group in enumerate(grouped_files)}  # Return as a dictionary
