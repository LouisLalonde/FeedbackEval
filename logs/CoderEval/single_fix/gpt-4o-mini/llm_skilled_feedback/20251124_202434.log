def _replace_url_args(url, url_args):
    """Replace any custom string URL items with values in args.
    
    This function replaces placeholders in the URL of the format '{key}:' 
    with corresponding values from the url_args dictionary. The expected 
    format for url_args is a dictionary where keys are the placeholders 
    to be replaced in the URL.

    Args:
        url (str): The URL containing placeholders to be replaced.
        url_args (dict): A dictionary mapping placeholders to their 
                         corresponding replacement values.

    Returns:
        str: The URL with placeholders replaced by their corresponding values.
    """
    if url_args:
        for key, value in url_args.items():
            url = url.replace(f"{key}:", f"{value}:")  # Ensure ':' is used consistently
    return url
