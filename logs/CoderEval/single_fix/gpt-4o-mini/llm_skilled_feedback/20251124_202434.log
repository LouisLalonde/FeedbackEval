def _legacy_mergeOrderings(orderings: List[List[Any]]) -> List[Any]:
    merged_ordering = []
    seen = set()  # Auxiliary set for faster membership checking

    # Iterate through each ordering in reverse to maintain the last occurrence
    for ordering in reversed(orderings):
        for element in reversed(ordering):
