import argparse

def parse_subparser_arguments(unparsed_arguments, subparsers):
    parser = argparse.ArgumentParser()
    subparser_parsers = {}
    
    # Create subparsers for each subparser name
    for subparser_name, subparser in subparsers.items():
        subparser_parsers[subparser_name] = subparser

    subparser_results = {}
    remaining_arguments = []

    # Parse arguments against each subparser
    for argument in unparsed_arguments:
        parsed = False
        for subparser_name, subparser_parser in subparser_parsers.items():
            try:
                # Attempt to parse the argument with the current subparser
                result = subparser_parser.parse_args([argument])
                subparser_results[subparser_name] = result
                parsed = True
                break  # Exit the loop if successfully parsed
            except SystemExit:
                # SystemExit is raised when parse_args fails
                continue
        
        if not parsed:
            remaining_arguments.append(argument)

    return subparser_results, remaining_arguments
