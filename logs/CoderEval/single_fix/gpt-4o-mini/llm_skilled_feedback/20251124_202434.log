def unit_of_work(metadata=None, timeout=None):
    def decorator(func):
        def wrapper(*args, **kwargs):
            # Validate timeout
            if timeout is not None and (timeout < 0):
                raise ValueError("Timeout must be a non-negative value or None.")
            
            # Prepare the transaction with metadata and timeout
            from neo4j import GraphDatabase
            
            driver = GraphDatabase.driver("bolt://localhost:7687")  # Adjust the URI as needed
            with driver.session() as session:
                # Set metadata if provided
                if metadata:
                    session.run("CALL dbms.setTXMetaData($metadata)", metadata=metadata)
                
                # Execute the transaction with timeout
                result = session.write_transaction(func, *args, **kwargs)
                
                return result

        return wrapper

    return decorator
</repaired_code>

