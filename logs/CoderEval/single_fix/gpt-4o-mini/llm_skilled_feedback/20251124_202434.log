def _extract_number_and_supplment_from_issue_element(issue):
    """
    Extrai do conteúdo de <issue>xxxx</issue>, os valores number e suppl.
    Valores possíveis
    5 (suppl), 5 Suppl, 5 Suppl 1, 5 spe, 5 suppl, 5 suppl 1, 5 suppl. 1,
    25 Suppl 1, 2-5 suppl 1, 2spe, Spe, Supl. 1, Suppl, Suppl 12,
    s2, spe, spe 1, spe pr, spe2, spe.2, spepr, supp 1, supp5 1, suppl,
    suppl 1, suppl 5 pr, suppl 12, suppl 1-2, suppl. 1
    """
    if not issue:
        return None, None

    issue = issue.strip().replace('.', '')
    splitted = [s for s in issue.split() if s]

    def handle_single_element(element):
        if element.isdigit():
            return element, None
        if 'sup' in element.lower():
            return None, '0'
        if element.startswith('s') and element[1:].isdigit():
            return None, element[1:]
        return element, None

    def handle_two_elements(first, second):
        if 'sup' in first.lower():
            return None, second
        if 'sup' in second.lower():
            return first, '0'
        return ''.join([first, second]), None

    def handle_three_elements(first, second, third):
        if 'sup' in second.lower():
            return first, third
        return None, None

    splitted = [('spe' if 'spe' in s.lower() or s.isalpha() else s) for s in splitted]

    if len(splitted) == 1:
        return handle_single_element(splitted[0])
    elif len(splitted) == 2:
        return handle_two_elements(splitted[0], splitted[1])
    elif len(splitted) == 3:
        return handle_three_elements(splitted[0], splitted[1], splitted[2])

    return ''.join(splitted), None
