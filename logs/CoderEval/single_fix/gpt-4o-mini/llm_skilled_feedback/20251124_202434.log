def _convert_non_cli_args(self, parser_name, values_dict):
    """Casts arguments to correct types by modifying values_dict param.

    By default all the values are strings.

    :param parser_name: The command name, e.g. main, virsh, ospd, etc
    :param values_dict: The dict of with arguments
    """
    for opt_name, opt_value in values_dict.items():
        file_option_spec = self.spec_helper.get_option_spec(parser_name, opt_name)
        
        # Check if the option type is int or action is count
        if file_option_spec.get('type') == 'int':
            try:
                values_dict[opt_name] = int(opt_value)
            except ValueError:
                # Handle the case where conversion fails
                values_dict[opt_name] = None  # or some default value or raise an error
        elif file_option_spec.get('action') == 'count':
            values_dict[opt_name] = values_dict.get(opt_name, 0) + 1
        # Handle unsupported types gracefully
        elif file_option_spec.get('type') is None:
            continue  # or handle as needed

    return values_dict
