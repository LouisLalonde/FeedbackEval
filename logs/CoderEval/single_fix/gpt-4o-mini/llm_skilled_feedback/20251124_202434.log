def test_tag(tag: str) -> bool:
    """Test a word whether it could be accepted as a tag.

    An acceptable tag consists only of alphanumeric characters and underscores.
    The check is case-sensitive, meaning 'Tag' and 'tag' are treated differently.

    Args:
        tag (str): The string to be tested as a tag.

    Returns:
        bool: True if the tag is acceptable, False otherwise.
    """
    ILLEGAL_TAG_CHARS = set("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_")
    for char in tag:
        if char not in ILLEGAL_TAG_CHARS:
            return False
    return True
