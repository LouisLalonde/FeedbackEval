import re

class ObjectException(Exception):
    pass

def next_version(version):
    """Next version identifier following existing pattern.

    Must deal with both zero-prefixed and non-zero prefixed versions.
    """
    # Improved regex to capture the full version number including zero-padded versions
    m = re.match(r'v(\d+)(0*)(\d*)$', version)
    if not m:
        raise ObjectException("Bad version '%s'" % version)

    major = int(m.group(1))
    zero_padding = m.group(2)
    minor = m.group(3)

    # Determine the next version number
    if minor:
        next_minor = int(minor) + 1
        next_version = f'v{major}{zero_padding}{next_minor}'
    else:
        next_major = major + 1
        next_version = f'v{next_major}'

    # Check for version number overflow in zero-padded version
    if len(next_version) != len(version):
        raise ObjectException(
            'Version number overflow for version %s to %s' %
            (version, next_version))

    return next_version
