        self.name,
        help=self.kwargs["description"],
        **self.kwargs)
    workspace_subparsers = workspace_plugin.add_subparsers(dest="command")

    def add_workspace_parser(command_name, help_text, *args, **kwargs):
        parser = workspace_subparsers.add_parser(command_name, help=help_text)
        for arg in args:
            parser.add_argument(*arg)
        for key, value in kwargs.items():
            parser.add_argument(key, **value)
        return parser

    # create
