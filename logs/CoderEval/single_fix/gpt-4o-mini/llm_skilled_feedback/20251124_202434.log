def determineMetaclass(bases, explicit_mc=None):
    """
    Determine metaclass from 1+ bases and optional explicit __metaclass__
    """
    if explicit_mc is not None:
        if not isinstance(explicit_mc, type):
            raise TypeError("explicit_mc must be a type.")
        return explicit_mc

    metaclasses = []
    for base in bases:
        if not isinstance(base, type):
            raise TypeError("All bases must be types.")
        metaclass = type(base)
        metaclasses.append(metaclass)

    if not metaclasses:
        raise TypeError("No valid metaclass found.")

    # Find the most specific metaclass
    metaclass = metaclasses[0]
    for mc in metaclasses[1:]:
        if issubclass(mc, metaclass):
            continue
        if not issubclass(metaclass, mc):
            metaclass = type('CombinedMeta', (metaclass, mc), {})

    return metaclass
</repaired_code>

