def _reset_logging(cls):
    """
    Reset the logging configuration by clearing all existing loggers 
    and resetting their levels to the default level (WARNING).
    """
    import logging

    # Get the root logger
    root_logger = logging.getLogger()
    
    # Close all handlers associated with the root logger
    for handler in root_logger.handlers[:]:
        handler.close()
        root_logger.removeHandler(handler)
    
    # Reset the logging level to WARNING
    root_logger.setLevel(logging.WARNING)

    # Optionally, reset other loggers if needed
    for name in logging.Logger.manager.loggerDict.keys():
        logger = logging.getLogger(name)
        logger.setLevel(logging.WARNING)
        # Clear handlers for each logger
        for handler in logger.handlers[:]:
            handler.close()
            logger.removeHandler(handler)
