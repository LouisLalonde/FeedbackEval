def popitem(self):
    if not self:
        raise KeyError("popitem(): dictionary is empty")
    
    # Assuming self is a dictionary-like object that maintains order
    # We will iterate through the items to find the least recently used
    # For this example, we'll assume self is an OrderedDict or similar
    key = next(iter(self))  # Get the first key (least recently used)
    value = self[key]       # Get the corresponding value
    del self[key]           # Remove the item from the dictionary
    return (key, value)     # Return the key-value pair
