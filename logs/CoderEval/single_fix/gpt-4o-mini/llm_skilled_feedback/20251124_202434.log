class LFUCache:
    def __init__(self, maxsize):
        self.cache = {}
        self.maxsize = maxsize
        self.freq = {}
        self.min_freq = 0

    def get(self, key):
        if key not in self.cache:
            return None
        value, freq = self.cache[key]
        self.freq[freq].remove(key)
        if not self.freq[freq]:
            del self.freq[freq]
            if self.min_freq == freq:
                self.min_freq += 1
        self.cache[key] = (value, freq + 1)
        self.freq.setdefault(freq + 1, []).append(key)
        return value

    def put(self, key, value):
        if self.maxsize <= 0:
            return
        if key in self.cache:
            self.cache[key] = (value, self.cache[key][1])
            self.get(key)  # Update frequency
            return
        if len(self.cache) >= self.maxsize:
            lfu_key = self.freq[self.min_freq][0]
            del self.cache[lfu_key]
            self.freq[self.min_freq].remove(lfu_key)
            if not self.freq[self.min_freq]:
                del self.freq[self.min_freq]
        self.cache[key] = (value, 1)
        self.freq.setdefault(1, []).append(key)
        self.min_freq = 1

def lfu_cache(maxsize=128, typed=False):
    lfu_cache_instance = LFUCache(maxsize)

    def decorator(func):
        def wrapper(*args, **kwargs):
            # Ensure that the key is hashable
            try:
                key = args if typed else tuple(args)
                if key in lfu_cache_instance.cache:
                    return lfu_cache_instance.get(key)
                result = func(*args, **kwargs)
                lfu_cache_instance.put(key, result)
                return result
            except TypeError:
                raise ValueError("Arguments must be hashable and cannot be mutable types.")
        
        return wrapper

    return decorator
