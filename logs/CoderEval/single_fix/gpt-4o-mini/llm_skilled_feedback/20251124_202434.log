def validate_min_max_args(self, args):
    """
    Check if value of arguments is between minimum and maximum values.

    :param args: The received arguments.
    :return: True if args are within the range, False otherwise.
    """
    minimum = 0
    maximum = 100
    
    # Check if args is a list or another iterable
    if isinstance(args, (list, tuple)):
        for arg in args:
            if not isinstance(arg, (int, float)) or arg < minimum or arg > maximum:
                raise IRInvalidMinMaxRangeException(f"Value {arg} is out of range.")
        return True
    elif isinstance(args, (int, float)):
        if args < minimum or args > maximum:
            raise IRInvalidMinMaxRangeException(f"Value {args} is out of range.")
