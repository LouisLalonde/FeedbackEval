    // Check if the input uri is null or empty
    if (uri == null || uri.length() == 0) {
        return (regexPattern == null) ? EMPTY_STRING_MATCH_RESULT : null;
    }
    
    // Check if the regex pattern is null
    if (regexPattern == null) {
        return null;
    }
    
    // Create a matcher for the given uri
    Matcher m = regexPattern.matcher(uri);
    
    // Check if the matcher finds a match
    if (!m.matches()) {
        return null;
    }
    
    // Return the appropriate match result based on groupIndexes
