private void pop(final int items){
  if (items <= 0) {
    return; // Early exit if no items to pop
  }
  
  if (outputStackTop >= items) {
    outputStackTop -= items; // Correctly pop items from the top
  } else {
    outputStackStart -= (items - outputStackTop); // Adjust start if not enough items
    outputStackTop = 0; // Reset top to zero after popping all
  }
}
