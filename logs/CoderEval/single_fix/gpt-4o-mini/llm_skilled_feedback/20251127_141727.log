private void pop(final int items){
  if (items <= 0) {
    throw new IllegalArgumentException("Number of items to pop must be positive.");
  }
  
  if (outputStackTop >= items) {
    outputStackTop -= items;
  } else {
    outputStackStart -= (items - outputStackTop);
    outputStackTop = 0;
  }
}
</repaired_code>

