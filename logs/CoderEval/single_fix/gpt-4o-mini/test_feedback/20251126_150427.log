def normalize_cmd(cmd: tuple[str, ...]) -> tuple[str, ...]:
    # Check if the command is a shebang and normalize it for Windows
    if cmd and cmd[0].startswith('#!'):
        # Normalize the shebang path
        shebang = cmd[0][2:]  # Remove the '#!' part
        normalized_shebang = parse_filename(shebang)  # Use external API to parse the filename
        cmd = (normalized_shebang,) + cmd[1:]  # Replace the shebang in the command

    # Normalize the executable path for Windows
    normalized_cmd = tuple(normexe(part) for part in cmd)
    
    return normalized_cmd
</repaired_code>

