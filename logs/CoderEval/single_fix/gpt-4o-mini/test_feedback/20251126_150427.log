def protocol_handlers(cls, protocol_version=None):
    if protocol_version is not None and not isinstance(protocol_version, tuple):
        raise TypeError("Protocol version must be passed in a tuple")
    
    handlers = {}
    
    if protocol_version is None:
        handlers[(1, 0)] = BoltProtocolHandlerV1()
        handlers[(2, 0)] = BoltProtocolHandlerV2()
        handlers[(3, 0)] = BoltProtocolHandlerV3()
        return handlers
    elif protocol_version == (1, 0):
        return {protocol_version: BoltProtocolHandlerV1()}
    elif protocol_version == (2, 0):
        return {protocol_version: BoltProtocolHandlerV2()}
    elif protocol_version == (3, 0):
        return {protocol_version: BoltProtocolHandlerV3()}
    else:
        raise ValueError("Invalid protocol version")
