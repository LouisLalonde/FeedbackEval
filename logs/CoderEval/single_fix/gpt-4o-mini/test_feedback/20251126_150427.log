from functools import wraps

def cachedmethod(cache, key=lambda *args, **kwargs: args, lock=None):
    """
    Decorator to wrap a class or instance method with a memoizing
    callable that saves results in a cache.
    
    Parameters:
    cache (dict): The cache to store results.
    key (callable): A function to generate cache keys from the arguments.
    lock (threading.Lock): An optional lock to ensure thread safety.
    
    Returns:
    callable: The decorated function with caching behavior.
    """
    def decorator(func):
        @wraps(func)
        def wrapper(*args, **kwargs):
            if lock is not None:
                lock.acquire()
            try:
                cache_key = key(*args, **kwargs)
                if cache_key in cache:
                    return cache[cache_key]
                else:
                    result = func(*args, **kwargs)
                    cache[cache_key] = result
                    return result
            finally:
                if lock is not None:
                    lock.release()
        return wrapper
    return decorator
```
