import argparse

def parse_subparser_arguments(unparsed_arguments, subparsers):
    parser = argparse.ArgumentParser()
    subparser_parsers = {}

    # Create subparsers for each subparser name
    for subparser_name, subparser in subparsers.items():
        # Instead of calling add_subparsers on the subparser directly,
        # we should call it on the main parser instance
        subparser_parsers[subparser_name] = parser.add_subparsers(dest=subparser_name)

        # Assuming subparser is an instance of argparse.ArgumentParser,
        # we need to add the arguments to the subparser here
        # This assumes that subparser has its own arguments defined
        subparser.add_arguments(subparser_parsers[subparser_name])

    subparser_results = {}
    remaining_arguments = []

    # Parse the unparsed arguments
    for argument in unparsed_arguments:
        parsed = False
        for subparser_name, subparser_parser in subparser_parsers.items():
            try:
                # Attempt to parse the argument using the current subparser
                subparser_results[subparser_name] = subparser_parser.parse_args([argument])
                parsed = True
                break
            except SystemExit:
                # Handle the case where parsing fails and raises SystemExit
                remaining_arguments.append(argument)
                parsed = True
                break
        if not parsed:
            remaining_arguments.append(argument)

    return subparser_results, remaining_arguments
