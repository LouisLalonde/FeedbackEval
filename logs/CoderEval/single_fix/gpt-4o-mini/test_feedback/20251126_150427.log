def point_type(name, fields, srid_map):
    """
    Dynamically create a Point subclass.
    
    Parameters:
    name (str): The name of the subclass to be created.
    fields (list): A list of field names that the Point subclass should have.
    srid_map (dict): A mapping of spatial reference IDs to their definitions.
    
    Returns:
    type: A new subclass of Point with the specified fields.
    """
    
    # Create a dictionary to hold the fields as properties
    attributes = {}
    
    # Dynamically create properties for each field
    for field in fields:
        attributes[field] = property(lambda self, field=field: self.__dict__.get(field, None))
    
    # Create the new Point subclass
    return type(name, (object,), attributes)
