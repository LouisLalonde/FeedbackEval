import re

class ObjectException(Exception):
    pass

def next_version(version):
    """Next version identifier following existing pattern.

    Must deal with both zero-prefixed and non-zero prefixed versions.
    """
    m = re.match(r'v(\d+)(0)?$', version)
    if not m:
        raise ObjectException("Bad version '%s'" % version)
    
    next_n = int(m.group(1)) + 1  # Increment the main version number
    if m.group(2) is not None:  # Check if there is a zero-padding
        next_v = 'v0' + str(next_n).zfill(len(version) - 1)  # Maintain zero-padding
        if len(next_v) != len(version):
            raise ObjectException(
                'Version number overflow for zero-padded version %s to %s' %
                (version, next_v))
        return next_v
    
    return 'v' + str(next_n)
</repaired_code>

