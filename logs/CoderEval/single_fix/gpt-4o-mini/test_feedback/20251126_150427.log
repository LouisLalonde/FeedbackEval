def initialize(self):
    """Create and initialize a new OCFL storage root."""
    try:
        # Check if the storage root already exists
        if exists(self.storage_root):
            raise StoreException("Storage root already exists.")

        # Create the storage root directory
        makedir(self.storage_root)

        # Open the filesystem at the storage root
        fs = open_fs(self.storage_root)

        # Perform any necessary initialization tasks
        # For example, creating a metadata file or initial structure
        with open(fs.open('metadata.json', 'w')) as metadata_file:
            metadata_file.write('{}')  # Initialize with empty JSON

        # Log successful initialization
        dump("OCFL storage root initialized successfully at: {}".format(self.storage_root))

    except Exception as e:
        raise StoreException("Failed to initialize OCFL storage root: {}".format(str(e)))
