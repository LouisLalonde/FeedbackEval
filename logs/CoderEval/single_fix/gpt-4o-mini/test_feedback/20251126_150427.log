def popitem(self):
    if not self:  # Check if the cache is empty
        raise KeyError("popitem(): cache is empty")  # Raise KeyError if empty
    # Remove and return the least recently used (key, value) pair
    key = next(iter(self))  # Get the first key (least recently used)
    value = self.pop(key)  # Remove the key from the cache and get its value
    return key, value  # Return the (key, value) pair
