def get_nodeinfo_well_known_document(url: str, document_path: str = None) -> dict:
    """
    Generate a NodeInfo .well-known document.

    See spec: http://nodeinfo.diaspora.software

    :arg url: The full base url with protocol, ie https://example.com
    :arg document_path: Custom NodeInfo document path if supplied (optional)
    :returns: dict
    """
    nodeinfo_document = {
        "url": url,
        "document_path": document_path or NODEINFO_DOCUMENT_PATH,  # Use NODEINFO_DOCUMENT_PATH if document_path is None
        "links": [
            {
                "rel": "http://nodeinfo.diaspora.software/ns/schema/1.0",
                "href": f"{url}/{document_path or NODEINFO_DOCUMENT_PATH}"  # Construct href based on the URL and document path
            }
        ]
    }
    return nodeinfo_document
