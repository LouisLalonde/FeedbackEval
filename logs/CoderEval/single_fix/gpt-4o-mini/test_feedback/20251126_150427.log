def find_path_type(path: str) -> str:
    # Check if the path is a root
    if path == "/":
        return "root"
    
    # Check if the path is an OCFL object
    if path.startswith("/objects/"):
        return "object"
    
    # Check if the path is a file (assuming files are in a specific directory)
    if path.endswith(".txt") or path.endswith(".json"):
        return "file"
    
    # If none of the above, return an error description
    return "Invalid path type"
