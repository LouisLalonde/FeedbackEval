def determineMetaclass(bases, explicit_mc=None):
    """
    Determine metaclass from 1+ bases and optional explicit __metaclass__
    """
    if explicit_mc is not None:
        return explicit_mc

    # If no explicit metaclass is provided, determine it from the bases
    if not bases:
        raise TypeError("At least one base class is required")

    # Start with the metaclass of the first base
    metaclass = type(bases[0])

    # Iterate through the bases to find the common metaclass
    for base in bases[1:]:
        base_metaclass = type(base)
        if metaclass is not base_metaclass:
            # If metaclasses are different, we need to resolve them
            if not isinstance(metaclass, base_metaclass):
                raise TypeError("Incompatible metaclasses: {} and {}".format(metaclass, base_metaclass))
            metaclass = base_metaclass

    return metaclass
</repaired_code>

