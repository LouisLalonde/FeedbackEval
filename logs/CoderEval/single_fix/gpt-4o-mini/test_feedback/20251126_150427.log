def bash_completion():
    """
    Return a bash completion script for the borgmatic command. Produce this by introspecting
    borgmatic's command-line argument parsers.
    """
    from borgmatic.arguments import make_parsers
    from borgmatic.arguments import items, parser_flags
    from borgmatic.arguments import Str

    # Create the argument parsers
    parsers = make_parsers()

    # Generate the completion script
    completion_script = "#!/bin/bash\n"
    completion_script += "function _borgmatic_completion() {\n"
    completion_script += "    local current_word previous_word\n"
    completion_script += "    current_word=${COMP_WORDS[COMP_CWORD]}\n"
    completion_script += "    previous_word=${COMP_WORDS[COMP_CWORD-1]}\n"
    completion_script += "    COMPREPLY=($(compgen -W '"

    # Collect all command options and arguments
    options = []
    for parser in parsers:
        options.extend(parser_flags(parser))
        options.extend(items(parser))

    completion_script += " ".join(options) + "' -- $current_word))\n"
    completion_script += "}\n"
    completion_script += "complete -F _borgmatic_completion borgmatic\n"

    return completion_script
