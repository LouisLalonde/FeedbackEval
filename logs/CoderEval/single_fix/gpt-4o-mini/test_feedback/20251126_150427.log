def validate_min_max_args(self, args):
    """
    Check if value of the given args is between minimum and maximum values.
    
    :param args: The received arguments.
    :return: True if args is within the range, False otherwise.
    """
    minimum = 0
    maximum = 100
    
    # Ensure that args is of a valid type (int or float)
    if not isinstance(args, (int, float)):
        raise IRInvalidMinMaxRangeException("Arguments must be a number.")
    
    if args < minimum or args > maximum:
        return False
    return True
