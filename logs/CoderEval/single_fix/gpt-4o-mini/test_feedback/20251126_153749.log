import argparse

def parse_subparser_arguments(unparsed_arguments, subparsers):
    parser = argparse.ArgumentParser()
    subparser_parsers = {}

    # Create subparsers for each subparser provided
    for subparser_name, subparser in subparsers.items():
        # Instead of calling add_subparsers on the subparser, we call it on the main parser
        subparser_parsers[subparser_name] = parser.add_subparsers(dest=subparser_name)

        # Add the subparser to the created subparsers
        subparser_parser = subparser_parsers[subparser_name].add_parser(subparser_name)
        subparser_parser.add_argument('--repository', help='Repository argument')  # Example of adding an argument

    subparser_results = {}
    remaining_arguments = []

    # Parse the arguments
    for argument in unparsed_arguments:
        parsed = False
        for subparser_name, subparser_parser in subparser_parsers.items():
            try:
                # Attempt to parse the argument
                subparser_results[subparser_name] = subparser_parser.parse_args([argument])
                parsed = True
                break
            except SystemExit:
                # Handle the case where parsing fails
                remaining_arguments.append(argument)
                parsed = True
                break
        if not parsed:
            remaining_arguments.append(argument)

    return subparser_results, remaining_arguments
