from typing import Dict, Union
import json

def parse_diaspora_webfinger(document: str) -> Dict:
    # Attempt to parse the document as JSON
    try:
        data = json.loads(document)
    except json.JSONDecodeError:
        raise ValueError("Invalid JSON format")

    # Ensure that the 'links' key exists and is a list
    if 'links' not in data or not isinstance(data['links'], list) or len(data['links']) == 0:
        raise ValueError("No links found in the document")

    return {
        'hcard_url': data['links'][0]['href']
    }
