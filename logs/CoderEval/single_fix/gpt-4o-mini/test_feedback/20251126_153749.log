def normalize_cmd(cmd: tuple[str, ...]) -> tuple[str, ...]:
    # Check if the command is a valid shebang and normalize it for Windows
    if cmd and cmd[0].startswith('#!'):
        # Normalize the shebang for Windows
        normalized_cmd = ('python.exe',) + cmd[1:]  # Assuming we want to use python.exe for shebangs
