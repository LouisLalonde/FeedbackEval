def find_path_type(path: str) -> str:
    # Check if the path is a root directory
    if path.endswith("/"):
        return "root"
    
    # Check if the path is an OCFL Object
    if "0=*" in path:
        return "object"
    
    # Check if the path is a file (could be an inventory)
    if path.endswith(".json") or path.endswith(".txt"):
        return "file"
    
    # If none of the above, return an error description
    return "Invalid path type or format"
