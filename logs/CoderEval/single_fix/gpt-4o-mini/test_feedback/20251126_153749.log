def is_fill_request_seq(seq: list) -> bool:
    """
    Test whether *seq* can be converted to a FillRequestSeq.

    True only if it is a FillRequest element
    or contains at least one such,
    and it is not a Source sequence.
    """
    if not isinstance(seq, list):
        return False
    
    # Check if seq contains at least one FillRequest and is not a Source sequence
    contains_fill_request = any(isinstance(item, FillRequest) for item in seq)
    is_source_sequence = all(isinstance(item, Source) for item in seq)
    
    return contains_fill_request and not is_source_sequence
</repaired_code>

