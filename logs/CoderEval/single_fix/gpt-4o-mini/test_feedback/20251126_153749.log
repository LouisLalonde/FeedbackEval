def load_configurations(config_filenames, overrides=None, resolve_env=True):
    import logging  # Import logging to use LogRecord
    from configparser import ParsingError  # Import ParsingError for handling parse errors

    parsed_configs = {}
    error_logs = []

    for filename in config_filenames:
        try:
            with open(filename, 'r') as file:
                config_data = parse_config_file(file)
                parsed_configs[filename] = config_data
        except (IOError, ParsingError) as e:
            # Create a LogRecord instance for the error
            error_logs.append(logging.LogRecord(name='load_configurations', level=logging.ERROR, pathname=filename, lineno=0, msg=str(e), args=None, exc_info=None))

    return parsed_configs, error_logs
