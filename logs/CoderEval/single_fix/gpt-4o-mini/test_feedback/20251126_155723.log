def dehydrate_point(value):
    """
    Dehydrator for Point data.

    :param value: A list or tuple containing coordinates for the point.
    :type value: list or tuple
    :return: A Point object or None if the input is invalid.
    :rtype: Point or None
    """
    
    class Point:
        def __init__(self, *coords):
            self.coords = coords
        
        def __repr__(self):
            return f"Point({', '.join(map(str, self.coords))})"

    if len(value) in (2, 3, 4):
        return Point(*value)
    else:
        return None
