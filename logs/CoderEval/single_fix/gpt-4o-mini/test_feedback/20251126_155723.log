def is_fill_request_seq(seq: list) -> bool:
    """
    Test whether *seq* can be converted to a FillRequestSeq.

    True only if it is a FillRequest element
    or contains at least one such,
    and it is not a Source sequence.
    """
    if not isinstance(seq, list):
        return False
    
    # Check if the sequence contains at least one FillRequest element
    has_fill_request = any(isinstance(item, FillRequest) for item in seq)
    
    # Check if the sequence is not a Source sequence
    is_not_source = not is_source(seq)
    
    return has_fill_request and is_not_source
