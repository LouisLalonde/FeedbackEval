    if path == "0=*":
        return "root"
    
    # Check if the path looks like an OCFL Object
    if "object" in path:
        return "object"
    
    # Check if the path is a file
    if path.endswith(".txt") or path.endswith(".json"):
        return "file"
    
    # If none of the above, return an error description
    return "Invalid path type"

