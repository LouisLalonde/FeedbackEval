import re

def regex_dict(item):
    regex_item = {}
    for key, value in item.items():
        regex_key = re.escape(key).replace('\\*', '.*')  # Convert wildcard '*' to regex '.*'
        regex_item[regex_key] = value  # Keep the value intact
    return regex_item

# Example usage
rules = {
    '*.cpp': {'a': 'arf', 'b': 'bark', 'c': 'coo'},
    '*.h': {'h': 'help'}
}
regex_keys = regex_dict(rules)
