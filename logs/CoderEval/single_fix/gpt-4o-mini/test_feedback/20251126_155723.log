def _getTargetClass(self):
    from zope.interface.declarations import getObjectSpecification
    # Retrieve the object specification
    spec = getObjectSpecification()
    # Return the implementation name without 'Py' or 'Fallback' suffix
    if spec:
        implementation_name = spec.__name__
        if implementation_name.endswith('Py'):
