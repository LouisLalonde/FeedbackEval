def lfu_cache(maxsize=128, typed=False):
    cache = {}

    def decorator(func):
        def wrapper(*args, **kwargs):
            key = args if typed else tuple(args)
            if key in cache:
                cache[key][1] += 1
                return cache[key][0]
            result = func(*args, **kwargs)
            if len(cache) >= maxsize:
                lfu_key = min(cache, key=lambda k: cache[k][1])
                del cache[lfu_key]
            cache[key] = [result, 1]
            return result

        return wrapper

    return decorator

