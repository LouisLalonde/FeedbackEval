def determineMetaclass(bases, explicit_mc=None):
    """
    Determine metaclass from 1+ bases and optional explicit __metaclass__

    Parameters:
    bases (list): A list of base classes from which to determine the metaclass.
    explicit_mc (type, optional): An explicit metaclass to use instead of the inferred one.

    Returns:
    type: The determined metaclass.
    """
    if explicit_mc is not None:
        return explicit_mc

    if not bases:
        raise TypeError("Must have at least one base class")

    # Start with the metaclass of the first base
    metaclass = type(bases[0])

    for base in bases[1:]:
        base_metaclass = type(base)
        if base_metaclass is not metaclass:
            # If the metaclasses are different, we need to resolve them
            metaclass = type('CombinedMeta', (metaclass, base_metaclass), {})

    return metaclass
</repaired_code>

