```python
import argparse

def parse_subparser_arguments(unparsed_arguments, subparsers):
    parser = argparse.ArgumentParser()
    subparser_parsers = {}

    for subparser_name, subparser in subparsers.items():
        # Ensure that subparser is an instance of argparse.ArgumentParser
        if isinstance(subparser, argparse.ArgumentParser):
            subparser_parsers[subparser_name] = subparser.add_subparsers(dest=subparser_name)
        else:
            raise TypeError(f"Expected an instance of argparse.ArgumentParser for '{subparser_name}', got {type(subparser)}")

    subparser_results = {}
    remaining_arguments = []

    for argument in unparsed_arguments:
        parsed = False
        for subparser_name, subparser_parser in subparser_parsers.items():
            try:
                subparser_results[subparser_name] = subparser_parser.parse_args([argument])
                parsed = True
                break
            except SystemExit:
                # Catch the SystemExit raised by parse_args when parsing fails
                remaining_arguments.append(argument)
                parsed = True
                break
        if not parsed:
            remaining_arguments.append(argument)

    return subparser_results, remaining_arguments
