def popitem(self):
    """
    Remove and return the (key, value) pair most recently used.
    """
    if self:  # Check if the dictionary is not empty
        key = next(reversed(self))  # Get the most recently used key
        value = self.pop(key)  # Remove the key and get its value
        return key, value  # Return the key-value pair
    else:
        raise KeyError('popitem(): dictionary is empty')  # Raise KeyError if empty
