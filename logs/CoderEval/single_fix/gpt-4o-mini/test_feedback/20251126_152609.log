def determineMetaclass(bases, explicit_mc=None):
    """
    Determine metaclass from 1+ bases and optional explicit __metaclass__
    """
    if explicit_mc is not None:
        return explicit_mc

    # Check if bases is empty
    if not bases:
        raise TypeError("At least one base class is required")

    # Get the metaclasses of all bases
    metaclasses = [type(base) for base in bases]

    # If there are no metaclasses, return the default type
    if not metaclasses:
        return type

    # Find the common metaclass
    common_metaclass = metaclasses[0]
    for mc in metaclasses[1:]:
        if common_metaclass is not mc:
            # If they are not the same, we need to resolve them
            common_metaclass = type('Meta', (common_metaclass, mc), {})

    return common_metaclass
