def find_path_type(path: str) -> str:
    # Check if the path is valid using the open_fs API
    try:
        fs = open_fs(path)
        # Use getinfo to retrieve information about the path
        info = getinfo(fs, path)
        # Determine the type of the path based on the info
        if info.is_dir:
            return "directory"
        elif info.is_file:
            return "file"
        else:
            return "unknown"
    except Exception as e:
        raise Exception(f"Error processing path: {e}")
