import re

def _get_resource_name_regex():
    # Compile a regex pattern that matches valid resource names
    pattern = re.compile(r'^[a-zA-Z0-9-]+$')
    
    # Test the regex pattern with some sample inputs to ensure it works correctly
    test_names = ["valid-name", "anotherValidName", "invalid_name!", "12345", "valid-name-123"]
    results = [bool(pattern.match(name)) for name in test_names]
    
    # Check if all test cases return True
    if not all(results):
        raise Exception("Result not True!!!")
    
    return pattern
