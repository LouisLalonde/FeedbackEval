    // Check if the uri is null or empty
    if (uri == null || uri.length() == 0) {
        return (regexPattern == null) ? EMPTY_STRING_MATCH_RESULT : null;
    }
    
    // Check if the regexPattern is null
    if (regexPattern == null) {
        return null;
    }
    
    // Create a matcher for the provided uri
