public static boolean substringMatch(CharSequence str, int index, CharSequence substring) {
    // Check if the starting index is out of bounds
    if (index < 0 || index + substring.length() > str.length()) {
        return false;
    }
    
    for (int j = 0; j < substring.length(); j++) {
        int i = index + j;
        // Check if the characters at the current position match
        if (str.charAt(i) != substring.charAt(j)) {
            return false;
        }
    }
    return true;
}
</repaired_code>

