private boolean unlink(ListNodeImpl<E> node){
  if (node == null) {
    return false; // Handle null node case
  }
  
  ListNodeImpl<E> prev = node.prev;
  ListNodeImpl<E> next = node.next;

  if (removeListNode(node)) {
    if (size == 1) { // If this is the last node
      head = null; // Set head to null
    } else {
      link(prev, next);
      if (head == node) {
        head = next; // Update head if necessary
      }
    }
    size--; // Decrement size after successful removal
    return true;
  }
  return false;
}
