def extostr(cls, e, max_level=30, max_path_level=5):
    """
    Format an exception.
    :param e: Any exception instance.
    :type e: Exception
    :param max_level: Maximum call stack level (default 30)
    :type max_level: int
    :param max_path_level: Maximum path level (default 5)
    :type max_path_level: int
    :return The exception readable string
    :rtype str
    """
    try:
        exc_type, exc_value, exc_traceback = sys.exc_info()
        if exc_traceback is None:
            return str(e)

        tb_list = list(extract_tb(exc_traceback))
        if max_level < len(tb_list):
            tb_list = tb_list[-max_level:]

        formatted_lines = []
        formatted_lines.append(f"Exception: {repr(e)}")
        
        for filename, line, func, text in tb_list:
            path_parts = filename.rsplit('/', max_path_level)
            short_path = '/'.join(path_parts[-max_path_level:])
            formatted_lines.append(f"  File '{short_path}', line {line}, in {func}")
            if text:
                formatted_lines.append(f"    {text}")

        return '\n'.join(formatted_lines)
    except:
        logger.warning("Failed to format exception")
        return str(e)
</repaired_code>

