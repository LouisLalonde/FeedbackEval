def deep_merge_nodes(nodes):
    result = []
    merged_keys = {}

    # First pass: collect all keys and their values
    for key_node, value_node in nodes:
        key = key_node.value
        
        if key in merged_keys:
            # If both current and existing values are MappingNodes, merge them
            if (isinstance(value_node, MappingNode) and 
                isinstance(merged_keys[key][1], MappingNode)):
                existing_mapping = dict((k.value, v) for k, v in merged_keys[key][1].value)
                current_mapping = dict((k.value, v) for k, v in value_node.value)
                
                # Recursively merge nested mappings
                merged_value = []
                all_keys = set(existing_mapping.keys()) | set(current_mapping.keys())
                
                for nested_key in all_keys:
                    if (nested_key in existing_mapping and 
                        nested_key in current_mapping and
                        isinstance(existing_mapping[nested_key], MappingNode) and
                        isinstance(current_mapping[nested_key], MappingNode)):
                        # Recursive merge for nested mappings
                        merged_nested = deep_merge_nodes([
                            (k, existing_mapping[nested_key]) 
                            for k in [ScalarNode(tag='tag:yaml.org,2002:str', value=nested_key)]
                        ] + [
                            (k, current_mapping[nested_key])
                            for k in [ScalarNode(tag='tag:yaml.org,2002:str', value=nested_key)]
                        ])
                        merged_value.extend(merged_nested)
                    else:
                        # For non-mapping nodes or when key exists in only one mapping,
                        # take the latest value
                        latest_value = current_mapping.get(
                            nested_key,
                            existing_mapping.get(nested_key)
                        )
                        merged_value.append((
                            ScalarNode(tag='tag:yaml.org,2002:str', value=nested_key),
                            latest_value
                        ))
                
                merged_keys[key] = (key_node, MappingNode(
                    tag='tag:yaml.org,2002:map',
                    value=merged_value
                ))
            else:
                # For non-mapping nodes, take the latest value
                merged_keys[key] = (key_node, value_node)
        else:
            merged_keys[key] = (key_node, value_node)

    # Convert merged result to final format
    for key_node, value_node in merged_keys.values():
        result.append((key_node, value_node))

    return result
</repaired_code>

The fixed code:

1. Now properly handles ruamel.yaml node types instead of plain dictionaries
2. Maintains the node structure throughout the merging process
3. Implements deep merging for nested MappingNodes
4. Preserves the original node types and tags
5. Handles the case where later values should override earlier ones for non-mapping nodes
6. Returns the result in the correct format as specified in the docstring

The code now correctly processes the example given in the docstring, merging nested configurations while maintaining the proper node structure and handling collisions appropriately.

