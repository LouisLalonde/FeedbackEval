from functools import wraps

def tzname_in_python2(namefunc):
    @wraps(namefunc)
    def wrapper(*args, **kwargs):
        name = namefunc(*args, **kwargs)
        if PY2 and isinstance(name, unicode):
            return name.encode('utf-8')
        return name
    return wrapper
