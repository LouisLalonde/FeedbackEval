<repaired_code>
import time
from functools import wraps
from collections import OrderedDict
from typing import Callable, Any, Union, Tuple, Dict

def ttl_cache(maxsize: int = 128, ttl: float = 600, 
              timer: Callable[[], float] = time.monotonic, 
              typed: bool = False):
    """
    Decorator that implements a TTL cache with LRU eviction policy.
    """
    def make_key(args: tuple, kwargs: dict) -> tuple:
        """Create a cache key from function arguments."""
        key = args if typed else tuple(str(arg) for arg in args)
        if kwargs:
            key += tuple(sorted((k, str(v)) for k, v in kwargs.items()))
        return key

    cache: OrderedDict = OrderedDict()
    
    def decorator(func: Callable) -> Callable:
        @wraps(func)
        def wrapper(*args: Any, **kwargs: Any) -> Any:
            key = make_key(args, kwargs)
            
            current_time = timer()
            if key in cache:
                result, timestamp = cache[key]
                if current_time - timestamp < ttl:
                    # Move the accessed item to the end (MRU position)
                    cache.move_to_end(key)
                    return result
                else:
                    del cache[key]
            
            result = func(*args, **kwargs)
            cache[key] = (result, current_time)
            
            if len(cache) > maxsize:
                cache.popitem(last=False)  # Remove oldest item (LRU)
            
            return result
        
        # Add cache clear method to wrapper
        wrapper.cache_clear = lambda: cache.clear()
        wrapper.cache_info = lambda: {
            'maxsize': maxsize,
            'ttl': ttl,
            'current_size': len(cache)
        }
        
        return wrapper
    
    return decorator
</repaired_code>

