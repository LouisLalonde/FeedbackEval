    num_objects = 0
    good_objects = 0
    
    # Open and validate the storage root
    with ocfl_opendir() as root:
        # Get all object paths
        for obj_path in root.object_paths():
            num_objects += 1
            
            try:
                # Validate object if requested
                if validate_objects:
                    status = root.validate(obj_path, check_digests=check_digests)
                    if status:
                        good_objects += 1
                    elif show_warnings:
                        print(f"Warning: Invalid object at {obj_path}")
                        print(f"Status: {root.status_str()}")
                
                # Get object info if not validating
                else:
                    root.info(obj_path)
                    good_objects += 1
                    
            except Exception as e:
                if show_warnings:
                    print(f"Error processing {obj_path}: {str(e)}")
    
    return num_objects, good_objects
