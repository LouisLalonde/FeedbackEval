import datetime

def parse_frequency(frequency):
    if frequency is None or frequency == "always":
        return None
    
    parts = frequency.strip().lower().split()
    if len(parts) != 2:
        raise ValueError("Invalid frequency format")
    
    try:
        number = int(parts[0])
    except ValueError:
        raise ValueError("Invalid number format")
    
    timeunit = parts[1]
    # Remove 's' at the end if present to handle both singular and plural forms
    if timeunit.endswith('s'):
        timeunit = timeunit[:-1]
    
    timeunit_mapping = {
        'day': 'days',
        'hour': 'hours',
        'minute': 'minutes',
        'second': 'seconds',
        'microsecond': 'microseconds',
        'millisecond': 'milliseconds',
        'week': 'weeks'
    }
    
    if timeunit not in timeunit_mapping:
        raise ValueError("Invalid timeunit")
        
    return datetime.timedelta(**{timeunit_mapping[timeunit]: number})
</repaired_code>

