def _include_groups(self, parser_dict):
    """Resolves the include dict directive in the spec files."""
    if not parser_dict:
        return
        
    # Create a deep copy to avoid modifying the original dict
    working_dict = deepcopy(parser_dict)
    
    # Process includes if present
    for group_name, group_data in working_dict.items():
        if isinstance(group_data, dict) and 'include' in group_data:
            includes = group_data.get('include', [])
            if not isinstance(includes, list):
                includes = [includes]
                
            # Process each include directive
            for include in includes:
                if include in parser_dict:
                    # Merge included group data
                    included_data = parser_dict.get(include, {})
                    for key, value in included_data.items():
                        if key not in group_data:
                            group_data[key] = deepcopy(value)
                else:
                    raise SpecParserException(
                        'Include group "{}" not found'.format(include)
                    )
            
            # Remove the include directive after processing
            del group_data['include']
    
    return working_dict
</repaired_code>

