def _resolve_string(matcher: dict) -> str:
    """
    Get the value from environment given a matcher containing a name and an optional default value in its group dict.
    If the variable is not defined in environment and no default value is provided, an Error is raised.
    """
    # Get the variable name and default value from matcher's group
    var_name = matcher['group']['name']
    default_value = matcher['group'].get('default')
    
    # Get value from environment
    value = os.getenv(var_name)
    
    # If value is not found in environment
    if value is None:
        # If default value is provided, use it
        if default_value is not None:
            return default_value
        # If no default value and no environment value, raise error
        raise ValueError("Environment variable '{}' not found and no default value provided".format(var_name))
    
    return value
</repaired_code>

