def determineMetaclass(bases, explicit_mc=None):
    """
    Determine metaclass from 1+ bases and optional explicit __metaclass__
    """
    meta = type
    
    # Check for explicit metaclass first
    if explicit_mc is not None:
        meta = explicit_mc
    
    # Get metaclasses from bases
    for base in bases:
        base_meta = getattr(base, '__class__', type(base))
        
        # If current metaclass is more specific, use it
        if issubclass(base_meta, meta):
            meta = base_meta
        # If incompatible metaclasses found, raise TypeError
        elif not issubclass(meta, base_meta):
            raise TypeError("Incompatible metaclass")
            
    return meta
</repaired_code>

