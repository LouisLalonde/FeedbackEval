def find_path_type(path: str) -> str:
    try:
        with open_fs(path) as fs:
            # Check if it's a file
            try:
                info = fs.getinfo('.')
                if not info.is_dir:
                    return 'file'
            except:
                return 'path not found'
            
            # Look for Namaste files
            namastes = find_namastes(fs, '.')
            
            # Check for OCFL Storage Root
            for n in namastes:
                if n.startswith('0=ocfl_'):
                    return 'root'
                    
            # Check for OCFL Object
            for n in namastes:
                if n.startswith('0=ocfl'):
                    return 'object'
                    
            return 'directory with no Namaste files'
    except Exception as e:
        return str(e)
</repaired_code>

