    """
    Wraps the 'ansible-playbook' CLI.
    """
    LOG.debug("Running ansible-playbook with workspace '{}' and plugin '{}'".format(
        ir_workspace, ir_plugin))
    
    cmd = ["ansible-playbook"]
    
