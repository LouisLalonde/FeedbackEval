def minimalBases(classes):
    """Reduce a list of base classes to its ordered minimum equivalent"""
    # Remove ClassType check since it's Python version specific
    candidates = []
    for m in classes:
        # Check if m is a subclass of any existing candidate
        for n in classes:
            if m != n and issubclass(n, m) and m is not n:
                break
        else:
            # Remove any existing candidates that are subclasses of m
            candidates = [c for c in candidates if not issubclass(c, m)]
            candidates.append(m)
    return candidates
</repaired_code>

