<repaired_code>
def bash_completion():
    """Return a bash completion script for the borgmatic command."""
    parsers = make_parsers()
    
    # Get all subcommands and their options
    subcommands = []
    options = set()
    
    for parser_name, parser in parsers.items():
        if parser_name != 'common':
            subcommands.append(parser_name)
        
        for action in parser._actions:
            for opt in action.option_strings:
                if opt.startswith('-'):
                    options.add(opt)
    
    # Build the completion script
    script = [
        '# Bash completion script for borgmatic',
        '_borgmatic()',
        '{',
        '    local cur prev words cword',
        '    _init_completion || return',
        '',
        '    # List of all subcommands',
        '    local commands="{}"'.format(' '.join(sorted(subcommands))),
        '',
        '    # List of all options',
        '    local options="{}"'.format(' '.join(sorted(options))),
        '',
        '    case "$prev" in',
        '        borgmatic)',
        '            COMPREPLY=( $(compgen -W "$commands $options" -- "$cur") )',
        '            return 0',
        '            ;;',
        '    esac',
        '',
        '    COMPREPLY=( $(compgen -W "$options" -- "$cur") )',
        '    return 0',
        '}',
        '',
        'complete -F _borgmatic borgmatic',
    ]
    
    return '\n'.join(script)
</repaired_code>

