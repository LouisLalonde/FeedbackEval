import requests
import xml.etree.ElementTree as ET
from urllib.parse import quote

def retrieve_and_parse_diaspora_webfinger(handle):
    try:
        # Sanitize and prepare the handle
        if '@' not in handle:
            raise ValueError("Invalid handle format - must contain '@'")
        
        # Extract domain from handle for constructing the URL
        username, domain = handle.split('@', 1)
        sanitized_handle = quote(f"acct:{handle}")
        url = f"https://{domain}/.well-known/webfinger?resource={sanitized_handle}"
        
        # Make the request with timeout and error handling
        response = requests.get(url, timeout=10)
        response.raise_for_status()  # Raise exception for bad status codes
        
        xml_data = response.content
        webfinger_data = {}
        
        # Parse XML with error handling
        try:
            root = ET.fromstring(xml_data)
            ns = {"xrd": "http://docs.oasis-open.org/ns/xri/xrd-1.0"}
            
            # Find aliases
            for alias in root.findall(".//xrd:Alias", ns):
                webfinger_data["alias"] = alias.text
                break  # Take the first alias
            
            # Find links
            for link in root.findall(".//xrd:Link", ns):
                rel = link.attrib.get("rel")
                href = link.attrib.get("href")
                
                if rel == "http://webfinger.net/rel/profile-page":
                    webfinger_data["profile_page"] = href
                elif rel == "http://schemas.google.com/g/2010#updates-from":
                    webfinger_data["updates_from"] = href
        
        except ET.ParseError as e:
            raise ValueError(f"Invalid XML response: {str(e)}")
        
        return webfinger_data
        
    except requests.RequestException as e:
        raise ConnectionError(f"Failed to retrieve webfinger document: {str(e)}")
    except ValueError as e:
        raise
    except Exception as e:
        raise RuntimeError(f"Unexpected error processing webfinger: {str(e)}")
</repaired_code>

