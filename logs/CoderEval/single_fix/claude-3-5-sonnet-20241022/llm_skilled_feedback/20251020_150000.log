        # If JSON parsing fails, try parsing as XRD
        try:
            xrd_doc = parse_xrd(document)
            hcard_link = find_link(xrd_doc, 'http://microformats.org/profile/hcard')
            if hcard_link:
                return {'hcard_url': hcard_link}
            
            logger.warning("No hcard link found in XRD webfinger document")
            return {}
            
        except Exception as e:
            logger.warning(f"Failed to parse webfinger document: {str(e)}")
            return {}
