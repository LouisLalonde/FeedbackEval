def unit_of_work(metadata=None, timeout=None):
    def decorator(func):
        def wrapper(*args, **kwargs):
            # Validate timeout value
            if timeout is not None:
                if not isinstance(timeout, (int, float)):
                    raise ValueError("Timeout must be a number")
                if timeout < 0:
                    raise ValueError("Timeout cannot be negative")

            # Validate metadata
            if metadata is not None:
                if not isinstance(metadata, dict):
                    raise ValueError("Metadata must be a dictionary")

            # Get the transaction object from the first argument
            if not args:
                raise ValueError("Transaction object is required")
            tx = args[0]

            # Set transaction metadata if provided
            if metadata:
                try:
                    tx.set_metadata(metadata)
                except AttributeError:
                    pass  # Silently handle if set_metadata is not available

            # Set transaction timeout if provided
            if timeout is not None:
                try:
                    tx.set_timeout(timeout)
                except AttributeError:
                    pass  # Silently handle if set_timeout is not available

            # Execute the decorated function
            return func(*args, **kwargs)

        return wrapper
    return decorator
</repaired_code>

