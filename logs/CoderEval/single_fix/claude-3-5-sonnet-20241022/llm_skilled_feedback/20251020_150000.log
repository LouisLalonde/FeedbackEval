def identify_request(request: RequestType):
    """Try to identify whether this is a Diaspora request.

    Try first public message. Then private message. The check if this is a legacy payload.

    Args:
        request (RequestType): The request to identify

    Returns:
        int: 2 if it's a Diaspora request (public or private), 1 if legacy payload

    The identification process:
    1. Check for public message by looking for encrypted_magic_envelope in JSON
    2. Check for private message by validating XML with magic envelope tag
    3. If neither matches, assume legacy payload
    """
    # Try to identify public message first (JSON format)
    try:
        data = json.loads(decode_if_bytes(request.body))
        if 'encrypted_magic_envelope' in data:
            return 2  # Identified as public Diaspora message
    except json.JSONDecodeError:
        # Specifically handle JSON decode errors - not a JSON payload
        pass
    except Exception as e:
        # Log other unexpected errors but continue with next check
        logger.debug(f"Error checking for public message: {str(e)}")

    # Try to identify private message (XML format)
    try:
        xml = etree.fromstring(encode_if_text(request.body))
        if xml.tag == MAGIC_ENV_TAG:
            return 2  # Identified as private Diaspora message
    except etree.ParseError:
        # Specifically handle XML parse errors - not an XML payload
        pass
    except Exception as e:
        # Log other unexpected errors but continue
        logger.debug(f"Error checking for private message: {str(e)}")

    # If no Diaspora format identified, assume legacy payload
    return 1
</repaired_code>

