import argparse
from collections import OrderedDict

def parse_subparser_arguments(unparsed_arguments, subparsers):
    parser = argparse.ArgumentParser()
    subparser_results = OrderedDict()
    remaining_arguments = list(unparsed_arguments)
    
    # Initialize results for all subparsers
    for subparser_name in subparsers.keys():
        subparser_results[subparser_name] = None
    
    # Keep trying to parse arguments until no more successful parses
    while remaining_arguments:
        initial_remaining_len = len(remaining_arguments)
        parsed_by_any = False
        
        # Try each subparser with current remaining arguments
        for subparser_name, subparser in subparsers.items():
            if subparser_results[subparser_name] is not None:
                continue
                
            try:
                # Use parse_known_args instead of parse_args to handle shared arguments
                parsed, unknown = subparser.parse_known_args(remaining_arguments)
                
                # If parsing was successful (no exception)
                if vars(parsed):
                    subparser_results[subparser_name] = parsed
                    remaining_arguments = unknown
                    parsed_by_any = True
                    break
                    
            except argparse.ArgumentError:
                continue
            
        # If no progress was made in this iteration, break to avoid infinite loop
        if not parsed_by_any or len(remaining_arguments) == initial_remaining_len:
            break
            
    # Clean up any None values from results
    subparser_results = {k: v for k, v in subparser_results.items() if v is not None}
    
    return subparser_results, remaining_arguments
