def validate_version_inventories(self, version_dirs):
    different_digests = set()  # Track digests that differ from root inventory
    
    for version_dir in version_dirs:
        # Check if inventory file exists for the current version
        inventory_path = os.path.join(version_dir, "inventory.xml")
        root_inventory_path = os.path.join("root", "inventory.xml")
        
        if not os.path.exists(inventory_path):
            return False
        
        # Check if content digests in the inventory match those in the root inventory
        inventory_digests = get_content_digests(inventory_path)
        root_inventory_digests = get_content_digests(root_inventory_path)
        
        # Find and record any digests that differ from root inventory
        for digest in inventory_digests:
            if digest not in root_inventory_digests:
                different_digests.add(digest)
        
        # Store the different digests as an instance variable for later validation
        self.different_digests = different_digests
        
        # Continue checking for inventory existence even if digests differ
        # This ensures all versions have inventories up to that point
        if not os.path.exists(inventory_path):
            return False
    
    return True
</repaired_code>

