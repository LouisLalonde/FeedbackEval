def process_text_links(text):
    """
    Process links in text, adding some attributes and linkifying textual links.
    """
    def link_callback(attrs, new=False):
        # Add target="_blank" and rel="noopener" for security
        attrs['target'] = '_blank'
        attrs['rel'] = 'noopener'
        
        # Ensure href starts with http:// or https:// if not already
        href = attrs.get('href', '')
        if href and not href.startswith(('http://', 'https://')):
            attrs['href'] = f'http://{href}'
            
        return attrs

    # Skip if text is None or empty
    if not text:
        return text

    # Create callbacks instance
    callbacks = callbacks()
    callbacks.get('link').append(link_callback)

    # Linkify the text with callbacks
    processed_text = linkify(text, callbacks=callbacks)
    
    return processed_text
