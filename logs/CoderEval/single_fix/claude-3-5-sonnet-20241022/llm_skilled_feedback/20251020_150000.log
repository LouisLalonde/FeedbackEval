import datetime

def parse_frequency(frequency):
    if frequency is None or frequency == "always":
        return None
    
    # Normalize the input string by stripping whitespace and converting to lowercase
    frequency = frequency.strip().lower()
    
    parts = frequency.split()
    if len(parts) != 2:
        raise ValueError("Frequency must be in format 'number timeunit' (e.g., '3 weeks')")
    
    try:
        number = int(parts[0])
    except ValueError:
        raise ValueError("First part must be a valid integer")
    
    timeunit = parts[1]
    
    # Remove 's' from the end if present (handle both singular and plural)
    if timeunit.endswith('s'):
        timeunit = timeunit[:-1]
    
    # Map of valid time units to their timedelta parameter names
    timeunit_map = {
        'week': 'weeks',
        'day': 'days',
        'hour': 'hours',
        'minute': 'minutes',
        'second': 'seconds',
        'millisecond': 'milliseconds',
        'microsecond': 'microseconds'
    }
    
    if timeunit not in timeunit_map:
        raise ValueError(f"Invalid time unit. Valid units are: {', '.join(timeunit_map.keys())}")
    
    # Create the timedelta with the appropriate parameter
    return datetime.timedelta(**{timeunit_map[timeunit]: number})
