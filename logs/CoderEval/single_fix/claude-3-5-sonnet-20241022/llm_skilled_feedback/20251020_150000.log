@staticmethod
def merge_extra_vars(vars_dict, extra_vars=None):
    """Extend ``vars_dict`` with ``extra-vars``

    :param vars_dict: Dictionary to merge extra-vars into
    :param extra_vars: List of extra-vars
    """
    # Handle case when extra_vars is None
    if not extra_vars:
        return vars_dict

    for extra_var in extra_vars:
        try:
            # Handle file-based input (starting with @)
            if extra_var.startswith('@'):
                try:
                    with open(extra_var[1:], 'r') as f_obj:
                        loaded_yml = yaml.safe_load(f_obj)
                    
                    # Merge loaded YAML with existing dictionary
                    dict_utils.dict_merge(
                        vars_dict,
                        loaded_yml,
                        conflict_resolver=dict_utils.ConflictResolver.
                        unique_append_list_resolver)
                except (IOError, yaml.YAMLError) as e:
                    raise exceptions.IRExtraVarsException(
                        f"Error loading YAML file {extra_var[1:]}: {str(e)}")

            # Handle key-value pair input (containing =)
            else:
                if '=' not in extra_var:
                    raise exceptions.IRExtraVarsException(
                        f"Invalid extra var format: {extra_var}. Expected format: key=value")
                
                key, value = extra_var.split("=", 1)
                
                # Handle file reference in value
                if value.startswith('@'):
                    try:
                        with open(value[1:], 'r') as f_obj:
                            loaded_yml = yaml.safe_load(f_obj)
                        
                        # Create temporary dict and insert loaded YAML
                        tmp_dict = {}
                        dict_utils.dict_insert(tmp_dict, loaded_yml, *key.split("."))
                        
                        # Merge temporary dict with main dict
                        dict_utils.dict_merge(
                            vars_dict,
                            tmp_dict,
                            conflict_resolver=dict_utils.ConflictResolver.
                            unique_append_list_resolver)
                    except (IOError, yaml.YAMLError) as e:
                        raise exceptions.IRExtraVarsException(
                            f"Error loading YAML file {value[1:]}: {str(e)}")
                
                # Handle direct value input
                else:
                    dict_utils.dict_insert(vars_dict, value, *key.split("."))
                    
        except Exception as e:
            raise exceptions.IRExtraVarsException(
                f"Error processing extra var '{extra_var}': {str(e)}")
    
    return vars_dict
</repaired_code>

