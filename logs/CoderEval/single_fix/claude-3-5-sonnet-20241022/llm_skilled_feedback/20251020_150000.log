import subprocess
import os
import shutil

def prepare_repository_from_archive(
    archive_path: str,
    filename: Optional[str] = None,
    tmp_path: Union[PosixPath, str] = "/tmp",
) -> str:
    """Given an existing archive_path, uncompress it.
    Returns a file repo url which can be used as origin url.

    This does not deal with the case where the archive passed along does not exist.
    """
    # Validate archive existence
    if not os.path.exists(archive_path):
        raise FileNotFoundError(f"Archive not found at path: {archive_path}")

    # Ensure tmp_path is string
    if not isinstance(tmp_path, str):
        tmp_path = str(tmp_path)

    # Ensure tmp_path exists
    os.makedirs(tmp_path, exist_ok=True)

    try:
        # Check if tar command is available
        if not shutil.which('tar'):
            raise RuntimeError("tar command not found in system PATH")

        # uncompress folder/repositories/dump for the loader to ingest
        subprocess.check_output(
            ["tar", "xf", archive_path, "-C", tmp_path],
            stderr=subprocess.PIPE
        )
    except subprocess.CalledProcessError as e:
        raise RuntimeError(f"Failed to extract archive: {e.stderr.decode()}")
    except Exception as e:
        raise RuntimeError(f"Error during archive extraction: {str(e)}")

    # build the origin url (or some derivative form)
    _fname = filename if filename is not None else os.path.basename(archive_path)
    repo_url = f"file://{tmp_path}/{_fname}"
    return repo_url
</repaired_code>

