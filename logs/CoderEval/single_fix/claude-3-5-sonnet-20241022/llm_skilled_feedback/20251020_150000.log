def _eval_file(prefix, file_path):
    """
    Evaluates file type (asset or rendition) based on file path and prefix.
    Returns file metadata including component_id and type classification.
    """
    if not file_path or not prefix:
        return None
    
    # Skip XML files and files not matching prefix
    if not file_path.startswith(prefix) or file_path.endswith(".xml"):
        return None
        
    # Get file extension
    _, ext = os.path.splitext(file_path)
    ext = ext.lower()
    
    # Build base metadata
    metadata = {
        "component_id": file_path,
        "file_path": file_path
    }
    
    # Classify file type
    if ext == ".pdf":
        metadata["ftype"] = "asset"
    else:
        metadata["ftype"] = "rendition"
        
    return metadata
</repaired_code>

