import urllib
from typing import Tuple


def _parse_image_ref(image_href: str) -> Tuple[str, str, bool]:
    """Parse an image href into composite parts.

    :param image_href: href of an image
    :returns: a tuple of the form (image_id, netloc, use_ssl)
    :raises ValueError: if the image_href is not a valid URL
    """
    if not image_href:
        raise ValueError("Image href cannot be empty")

    try:
        # Parse the URL into its components
        parsed_url = urllib.parse.urlparse(image_href)
        
        # Validate that we have the minimum required URL components
        if not parsed_url.netloc or not parsed_url.path:
            raise ValueError("Invalid image URL format")

        # Extract the components
        netloc = parsed_url.netloc
        image_id = parsed_url.path.split('/')[-1]  # Use integer index instead of float
        use_ssl = parsed_url.scheme == 'https'

        return image_id, netloc, use_ssl
        
    except Exception as e:
        raise ValueError(f"Failed to parse image URL: {str(e)}")
