            # Split condition into parts
            parts = condition.strip().split()
            if len(parts) == 3:  # Simple comparison
                left, op, right = parts
                left_val = args.get(left)
                right_val = right.strip("'\"")  # Remove quotes if present
                
                if op == '==':
                    return str(left_val) == right_val
                elif op == '!=':
                    return str(left_val) != right_val
                elif op == 'in':
                    return left_val in right_val.split(',')
            elif 'and' in condition:
                subconds = condition.split('and')
                return all(evaluate_condition(cond.strip(), args) for cond in subconds)
            elif 'or' in condition:
                subconds = condition.split('or')
                return any(evaluate_condition(cond.strip(), args) for cond in subconds)
            
            return False
        except (KeyError, AttributeError, ValueError) as e:
            # Log error or handle specifically if needed
            return False
    
