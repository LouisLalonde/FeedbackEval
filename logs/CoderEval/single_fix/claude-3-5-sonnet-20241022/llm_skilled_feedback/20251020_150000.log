def determineMetaclass(bases, explicit_mc=None):
    """
    Determine metaclass from 1+ bases and optional explicit __metaclass__
    """
    metaclass = None
    
    # If explicit metaclass is provided, start with it
    if explicit_mc is not None:
        metaclass = explicit_mc
    
    # Get minimal bases to avoid redundant base classes
    base_classes = minimalBases(bases)
    
    # Check metaclasses from all bases
    for base in base_classes:
        # Get base metaclass
        base_mc = getattr(base, '__class__', type(base))
        
        if metaclass is None:
            metaclass = base_mc
        elif issubclass(base_mc, metaclass):
            continue
        elif issubclass(metaclass, base_mc):
            metaclass = base_mc
        else:
            raise TypeError("Incompatible metaclass combination")
    
    # If no metaclass was found, use type as default
    if metaclass is None:
        metaclass = type
    
    # Validate the resulting metaclass
    if len(base_classes) > 0:
        for base in base_classes:
            if not isinstance(base, metaclass):
                raise TypeError(f"metaclass conflict: the metaclass of a derived class "
                              f"must be a subclass of the metaclasses of all its bases")
    
    return metaclass
</repaired_code>

