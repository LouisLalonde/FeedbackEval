import re
from typing import Union

def get_pattern(pattern: Union[str, re.Pattern], strip: bool = False) -> re.Pattern:
    """
    This method converts the given string to regex pattern

    Args:
        pattern: Input string or compiled regex pattern
        strip: Boolean flag to strip whitespace from string pattern

    Returns:
        re.Pattern: Compiled regex pattern

    Raises:
        TypeError: If pattern is neither string nor compiled regex pattern
    """
    if isinstance(pattern, re.Pattern):
        return pattern
    
    if not isinstance(pattern, str):
        raise TypeError("Pattern must be either string or compiled regex pattern")

    processed_pattern = pattern.strip() if strip else pattern
    return re.compile(processed_pattern + '$')
