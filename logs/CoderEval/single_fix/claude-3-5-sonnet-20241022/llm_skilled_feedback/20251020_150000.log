def validate_length_args(self, args):
    """
    Check if value of arguments is not longer than length specified.

    :param args: The received arguments. Expected to be a dictionary or mapping
                containing argument names and their values to validate.
    :raises IRInvalidLengthException: If any argument value exceeds its specified length
    """
    # Get parser specifications which contain length constraints
    specs = self.get_parser_option_specs()
    
    # Track any length violations
    violations = []
    
    # Validate each argument
    for arg_name, arg_value in args.items():
        # Skip if argument is None or empty
        if arg_value is None or arg_value == '':
            continue
            
        # Get the spec for this argument if it exists
        spec = specs.get(arg_name)
        if spec and 'length' in spec:
            max_length = int(spec['length'])
            
            # Check if argument length exceeds specified maximum
            if len(str(arg_value)) > max_length:
                violations.append(f"Argument '{arg_name}' exceeds maximum length of {max_length}")
    
    # If any violations were found, raise exception
    if violations:
        raise IRInvalidLengthException('\n'.join(violations))
