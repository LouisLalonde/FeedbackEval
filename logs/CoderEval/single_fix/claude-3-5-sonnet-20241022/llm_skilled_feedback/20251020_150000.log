def next_version(version):
    """Next version identifier following existing pattern.

    Must deal with both zero-prefixed and non-zero prefixed versions.
    """
    VERSION_PREFIX = 'v'
    # Improved regex to handle both zero-padded and non-zero-padded versions
    m = re.match(f'{VERSION_PREFIX}(0?)(\\d+)$', version)
    
    if not m:
        raise ObjectException(f"Bad version '{version}'")
    
    # Extract padding and number components
    has_padding = m.group(1) == '0'
    current_num = int(m.group(2))
    next_num = current_num + 1  # Increment by 1 instead of 2
    
    if has_padding:
        # Handle zero-padded version
        num_width = len(m.group(2))  # Get width of the number part
        next_v = f'{VERSION_PREFIX}0{next_num:0{num_width}d}'
        
        # Check for overflow
        if len(next_v) != len(version):
            raise ObjectException(
                f'Version number overflow for zero-padded version {version} to {next_v}'
            )
        return next_v
    else:
        # Handle non-zero-padded version
        return f'{VERSION_PREFIX}{next_num}'
