def fix_namespace_prefix_w(content: str) -> str:
    if not content:
        logger.debug("Empty content received, returning as is")
        return content
        
    if "w:st=" not in content:
        logger.debug("No 'w:st=' found in content, returning unchanged")
        return content
        
