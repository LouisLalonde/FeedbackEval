def _include_groups(self, parser_dict):
    """
    Resolves the include dict directive in the spec files.
    
    Args:
        parser_dict (dict): Dictionary containing parser specifications with potential include directives
        
    Returns:
        dict: Processed dictionary with resolved include directives
        
    Raises:
        SpecParserException: If include directive is invalid or circular dependencies are detected
    """
    try:
        # Create a deep copy to avoid modifying the original dict during processing
        processed_dict = deepcopy(parser_dict)
        
        # Process all groups that have include directives
        for group_name, group_data in processed_dict.items():
            if isinstance(group_data, dict) and 'include' in group_data:
                includes = group_data.get('include', [])
                if not isinstance(includes, list):
                    includes = [includes]
                
                # Resolve each included group
                for include_name in includes:
                    if not isinstance(include_name, str):
                        raise SpecParserException(
                            "Invalid include directive: {} must be a string".format(include_name)
                        )
                    
                    # Get the referenced group
                    included_group = parser_dict.get(include_name)
                    if not included_group:
                        raise SpecParserException(
                            "Cannot resolve include directive: group '{}' not found".format(include_name)
                        )
                    
                    # Merge the included group data
                    for key, value in included_group.items():
                        if key != 'include':  # Avoid processing nested includes
                            if key not in group_data:
                                group_data[key] = value
                            elif isinstance(group_data[key], list):
                                group_data[key].extend(
                                    [v for v in value if v not in group_data[key]]
                                )
                
                # Remove the include directive after processing
                del group_data['include']
        
        return processed_dict
        
    except Exception as e:
        raise SpecParserException("Error processing include directive: {}".format(str(e)))
</repaired_code>

