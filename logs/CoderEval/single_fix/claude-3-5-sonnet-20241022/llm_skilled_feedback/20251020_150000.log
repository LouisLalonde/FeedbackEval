    result = {}
    for key, value in d1.items():
        if key not in d2:
            # Key only in d1, include it
            if isinstance(value, dict) and level != 0:
                # For nested dictionaries, make a deep copy
                result[key] = difference(value, {}, level - 1 if level > 0 else -1)
            else:
                result[key] = value
        elif level != 0:
            # Key in both dictionaries
            if isinstance(value, dict) and isinstance(d2[key], dict):
                # Recursive comparison for nested dictionaries
                nested_diff = difference(value, d2[key], level - 1 if level > 0 else -1)
                if nested_diff:
                    result[key] = nested_diff
            elif level == 1 or (level < 0 and value != d2[key]):
                # Include if values differ at level 1 or during infinite recursion
                result[key] = value
    return result
