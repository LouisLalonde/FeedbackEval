def _reset_logging(cls):
    """
    Reset logging configuration by closing and removing all handlers 
    from the root logger and resetting its level to default.
    
    This class method cleans up the logging state by:
    - Getting the root logger
    - Removing and closing all handlers
    - Resetting the log level
    """
    root_logger = logging.getLogger()
    
    # Close and remove all handlers
    for handler in root_logger.handlers[:]:
        handler.close()
        root_logger.removeHandler(handler)
    
    # Reset to default logging level
    root_logger.setLevel(logging.WARNING)  # WARNING is Python's default level
