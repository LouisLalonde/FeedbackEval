def validate_min_max_args(self, args):
    """
    Check if value of arguments is between minimum and maximum values.
    
    :param args: The received arguments.
    """
    minimum = 0
    maximum = 100
    
    try:
        # Handle single value
        if isinstance(args, (int, float)):
            if args < minimum or args > maximum:
                raise IRInvalidMinMaxRangeException(
                    f"Value {args} is outside valid range [{minimum}, {maximum}]"
                )
            return True
            
        # Handle iterable inputs (lists, tuples, etc.)
        if hasattr(args, '__iter__'):
            values = []
            for val in args:
                if not isinstance(val, (int, float)):
                    raise IRInvalidMinMaxRangeException(
                        f"Invalid type for value {val}. Expected numeric value."
                    )
                if val < minimum or val > maximum:
                    raise IRInvalidMinMaxRangeException(
                        f"Value {val} is outside valid range [{minimum}, {maximum}]"
                    )
                values.append(val)
            return True
            
        raise IRInvalidMinMaxRangeException(
            "Invalid input type. Expected numeric value or iterable of numeric values."
        )
        
    except Exception as e:
        if not isinstance(e, IRInvalidMinMaxRangeException):
            raise IRInvalidMinMaxRangeException(
                f"Error validating min/max args: {str(e)}"
            )
        raise
