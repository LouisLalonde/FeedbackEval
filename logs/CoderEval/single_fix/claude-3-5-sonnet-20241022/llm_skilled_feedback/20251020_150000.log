    :param key: a key, can be either:
               - an integer (0-based index)
               - a string (key to search for)
    :return: index of the item in the collection
    :rtype: int
    :raises IndexError: if integer index is out of range
    :raises KeyError: if string key is not found
    :raises TypeError: if key is neither integer nor string
    """
    if isinstance(key, int):
        if 0 <= key < len(self.__keys):  # Changed to 0-based indexing
            return key
        raise IndexError(f"Index {key} is out of range. Valid range is 0 to {len(self.__keys) - 1}")
    elif isinstance(key, str):
        if not self.__keys:  # Handle empty list case
            raise KeyError(f"Key '{key}' not found in empty collection")
        try:
            return self.__keys.index(key)
        except ValueError:
            raise KeyError(f"Key '{key}' not found in collection")
    else:
        raise TypeError(f"Key must be integer or string, not {type(key).__name__}")
</repaired_code>

