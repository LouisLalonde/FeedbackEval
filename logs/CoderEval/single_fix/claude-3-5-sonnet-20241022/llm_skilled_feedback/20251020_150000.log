import argparse
from collections import OrderedDict

def parse_subparser_arguments(unparsed_arguments, subparsers):
    parser = argparse.ArgumentParser()
    subparser_dict = OrderedDict()
    
    # Initialize subparsers
    for subparser_name, subparser in subparsers.items():
        subparser_dict[subparser_name] = parser.add_subparsers(dest=subparser_name)
        subparser.add_parser_arguments(subparser_dict[subparser_name])
    
    parsed_args = {}
    remaining_args = list(unparsed_arguments)  # Create a copy to modify safely
    
    # Try each subparser with all remaining arguments
    for subparser_name, subparser in subparser_dict.items():
        if not remaining_args:  # Exit early if no arguments left
            break
            
        try:
            # Use parse_known_args to handle partial parsing
            parsed, unknown = subparser.parse_known_args(remaining_args)
            
            # Only store results if actual arguments were parsed
            if vars(parsed).get(subparser_name) is not None:
                parsed_args[subparser_name] = parsed
                
                # Update remaining_args by removing successfully parsed arguments
                for arg in set(remaining_args) - set(unknown):
                    if arg in remaining_args:
                        remaining_args.remove(arg)
                        
        except (argparse.ArgumentError, SystemExit):
            # Catch both ArgumentError and SystemExit (raised by argparse on error)
            continue
    
    return parsed_args, remaining_args
