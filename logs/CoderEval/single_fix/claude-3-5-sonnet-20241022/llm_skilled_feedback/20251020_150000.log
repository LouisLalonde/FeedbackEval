def size_to_bytes(size: str) -> int:
    units = {'B': 1, 'K': 1024, 'M': 1024**2, 'G': 1024**3, 'T': 1024**4}
    
    # Handle case where input is just a number (assumed bytes)
    if size.isdigit():
        return int(size)
    
    # Validate that the size string ends with a valid unit
    unit = size[-1].upper()
    if unit not in units:
        raise ValueError(f"Invalid unit: {unit}. Expected one of {', '.join(units.keys())}")
    
    try:
        magnitude = int(size[:-1])
        return magnitude * units[unit]
    except ValueError:
        raise ValueError("Size value must be a valid number")
</repaired_code>

