def hydrate_time(nanoseconds, tz=None):
    """
    Hydrator for `Time` and `LocalTime` values.
    
    :param nanoseconds: Integer representing time in nanoseconds since midnight
                       (range: 0 to 86399999999999)
    :param tz: Optional timezone string or FixedOffset object
    :return: Time string in format "HH:MM:SS" or "HH:MM:SS TZ"
    """
    # Use divmod for cleaner division and remainder calculations
    hours, remainder = divmod(nanoseconds, 3600000000000)
    minutes, remainder = divmod(remainder, 60000000000)
    seconds, _ = divmod(remainder, 1000000000)
    
    # Ensure values are within valid ranges
    hours = int(hours % 24)
    minutes = int(minutes % 60)
    seconds = int(seconds % 60)
    
    # Format time string
    time_string = "{:02d}:{:02d}:{:02d}".format(hours, minutes, seconds)
    
    # Handle timezone if provided
    if tz is not None:
        # If tz is a FixedOffset object, use its string representation
        if isinstance(tz, FixedOffset):
            tz = str(tz)
        time_string = f"{time_string} {tz}"
    
    return time_string
</repaired_code>

