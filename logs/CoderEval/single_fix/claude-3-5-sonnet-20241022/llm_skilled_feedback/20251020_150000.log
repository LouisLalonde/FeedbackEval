def find_tags(text: str, replacer: Callable[[str], str] = None) -> Tuple[Set[str], str]:
    if replacer is None:
        replacer = lambda x: x
    
    tags: Set[str] = set()
    code_block = False
    replaced_text = ""
    current_word = ""
    
    for char in text:
        if char == '`':
            # Handle code block markers
            if current_word:
                # Process any accumulated word before code block
                tags.add(current_word.lower())
                replaced_text += replacer(current_word)
                current_word = ""
            code_block = not code_block
            replaced_text += char
        elif code_block:
            # Inside code block, just copy characters
            replaced_text += char
        elif char.isalnum() or char == '_':
            # Build current word
            current_word += char
        else:
            # Process word boundary
            if current_word:
                tags.add(current_word.lower())
                replaced_text += replacer(current_word)
                current_word = ""
            replaced_text += char
    
    # Handle last word if exists
    if current_word:
        tags.add(current_word.lower())
        replaced_text += replacer(current_word)
    
    return tags, replaced_text
