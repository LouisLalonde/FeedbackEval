def extostr(cls, e, max_level=30, max_path_level=5):
    import sys
    import traceback
    
    # Initialize the result list
    result = []
    
    # Get exception info
    if e.__traceback__ is not None:
        tb = e.__traceback__
    else:
        _, _, tb = sys.exc_info()
    
    # Extract traceback information
    tb_list = list(traceback.extract_tb(tb))
    
    # Limit traceback to max_level
    if len(tb_list) > max_level:
        logger.warning(f"Traceback exceeded max_level ({max_level}), truncating...")
        tb_list = tb_list[-max_level:]
    
    # Format exception type and message
    result.append(f"{e.__class__.__name__}: {str(e)}")
    
    # Process each traceback entry
    for filename, line, func, text in reversed(tb_list):
        # Format the path with max_path_level
        path_parts = filename.rsplit('/', max_path_level) if '/' in filename else filename.rsplit('\\', max_path_level)
        if len(path_parts) > max_path_level:
            short_path = ".../" + "/".join(path_parts[-max_path_level:])
        else:
            short_path = "/".join(path_parts)
            
        # Format the traceback line
        trace_line = f"  File \"{short_path}\", line {line}, in {func}"
        if text:
            trace_line += f"\n    {text}"
        result.append(trace_line)
    
    # Join all lines with newlines
    return "\n".join(result)
</repaired_code>

