def get_spec_defaults(self):
    """Resolve arguments' values from spec and other sources. """

    def spec_default_getter(option):
        """Getter function to retrieve the default value from spec.

        :param option: argument name
        """
        try:
            # Validate option dictionary has required key
            if not isinstance(option, dict) or 'name' not in option:
                raise KeyError("Option must be a dictionary containing 'name' key")

            default_value = SpecParser.get_env_option(option['name'])
            
            if default_value is not None:
                LOG.info(
                    "[environ] Loading argument '%s' default value '%s' from the environment variable",
                    option['name'],
                    str(default_value)
                )
            elif option.get('default', None) is not None:
                default_value = option['default']
                LOG.info(
                    "[spec] Using default value '%s' for argument '%s' from specification",
                    str(default_value),
                    option['name']
                )
            elif option.get('action', None) in ['store_true']:
                default_value = 1
                LOG.info(
                    "[spec] Using boolean default value '1' for argument '%s'",
                    option['name']
                )
            else:
                default_value = None
                LOG.info(
                    "[spec] No default value found for argument '%s'",
                    option['name']
                )
            
            return default_value

        except Exception as e:
            LOG.error(
                "[spec] Error processing default value for option: %s. Error: %s",
                str(option.get('name', 'unknown')),
                str(e)
            )
            return None

    return self._get_defaults(spec_default_getter)
