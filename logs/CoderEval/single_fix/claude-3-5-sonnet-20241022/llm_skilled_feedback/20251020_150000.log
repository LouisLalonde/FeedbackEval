def dict_insert(dic, val, key, *keys):
    # Type checking for dictionary
    if not isinstance(dic, dict):
        raise TypeError("First argument must be a dictionary")

    # Combine key with keys for consistent handling
    all_keys = (key,) + keys

    if not all_keys:
        return dic

    current_key = all_keys[0]
    remaining_keys = all_keys[1:]

    if not remaining_keys:
        # We've reached the final key, set the value
        dic[current_key] = val
    else:
        # Create/ensure nested dictionary exists and continue recursion
        dic.setdefault(current_key, {})
        dict_insert(dic[current_key], val, remaining_keys[0], *remaining_keys[1:])

    return dic
</repaired_code>

