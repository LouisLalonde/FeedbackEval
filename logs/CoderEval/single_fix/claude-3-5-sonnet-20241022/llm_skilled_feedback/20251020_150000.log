def create_complex_argument_type(self, subcommand, type_name, option_name, spec_option):
    """Build the complex argument type

    :param subcommand: the command name
    :param type_name: the complex type name
    :param option_name: the option name
    :param spec_option: option's specifications (dict containing option configuration)
    :return: the complex type instance
    :raises SpecParserException: if type_name is not found in COMPLEX_TYPES or if required parameters are missing
    """
    if type_name not in COMPLEX_TYPES:
        raise SpecParserException("Unknown complex type: {}".format(type_name))
    
    if not spec_option:
        raise SpecParserException("Missing specification for option: {}".format(option_name))
        
    try:
        complex_type = COMPLEX_TYPES[type_name](self.vars, self.defaults, self.plugin_path)
        return complex_type.complex_action(option_name, subcommand, spec_option)
    except Exception as e:
        raise SpecParserException("Failed to create complex argument type: {}".format(str(e)))
</repaired_code>

