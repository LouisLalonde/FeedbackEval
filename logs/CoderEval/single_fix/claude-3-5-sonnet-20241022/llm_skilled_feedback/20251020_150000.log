def deep_merge_nodes(nodes):
    result = []
    merged_keys = {}

    # First pass: collect all keys and their values
    for node in nodes:
        if not isinstance(node, tuple) or len(node) != 2:
            continue
            
        key, value = node
        if not hasattr(key, 'value'):
            continue

        key_value = key.value
        
        if key_value not in merged_keys:
            merged_keys[key_value] = (key, value)
        else:
            # If both are MappingNodes, deep merge them
            if (isinstance(merged_keys[key_value][1], MappingNode) and 
                isinstance(value, MappingNode)):
                merged_value = deep_merge_nodes(
                    merged_keys[key_value][1].value + value.value
                )
                merged_keys[key_value] = (
                    key,
                    MappingNode(
                        tag='tag:yaml.org,2002:map',
                        value=merged_value
                    )
                )
            else:
                # For non-MappingNodes, last value wins
                merged_keys[key_value] = (key, value)

    # Convert merged dictionary back to list of tuples
    for key_value, (key, value) in merged_keys.items():
        result.append((key, value))

    return result
</repaired_code>

