def add_asset(self, basename, file_path):
    """
    Adds an asset to the internal assets dictionary with basename as key and processed file path as value.
    
    Args:
        basename (str): The base name of the asset to be used as key
        file_path (str): The full file path of the asset
        
    Returns:
        None
        
    Raises:
        ValueError: If basename or file_path is invalid
    """
    # Validate inputs
    if not basename or not isinstance(basename, str):
        raise ValueError("basename must be a non-empty string")
    if not file_path or not isinstance(file_path, str):
        raise ValueError("file_path must be a non-empty string")
    
    # Process the file path using the file_path method
    try:
        processed_path = self.file_path(file_path)
        
        # Add the asset to the dictionary
        self._assets[basename] = processed_path
    except Exception as e:
        raise ValueError(f"Failed to process file path: {str(e)}")
