def lfu_cache(maxsize=128, typed=False):
    class LFUNode:
        def __init__(self, key, value, freq=1):
            self.key = key
            self.value = value
            self.freq = freq

    class LFUCache:
        def __init__(self, capacity):
            self.capacity = capacity
            self.cache = {}  # key -> LFUNode
            self.frequencies = collections.defaultdict(collections.OrderedDict)
            self.min_freq = 0

        def get(self, key):
            if key not in self.cache:
                return None
            node = self.cache[key]
            self._update_freq(node)
            return node.value

        def put(self, key, value):
            if self.capacity <= 0:
                return

            if key in self.cache:
                node = self.cache[key]
                node.value = value
                self._update_freq(node)
                return

            if len(self.cache) >= self.capacity:
                # Remove the least frequent item
                lfu_dict = self.frequencies[self.min_freq]
                lfu_key, _ = lfu_dict.popitem(last=False)
                del self.cache[lfu_key]
                if not lfu_dict:
                    del self.frequencies[self.min_freq]

            # Add new item
            node = LFUNode(key, value)
            self.cache[key] = node
            self.frequencies[1][key] = node
            self.min_freq = 1

        def _update_freq(self, node):
            # Remove from old frequency list
            del self.frequencies[node.freq][node.key]
            if not self.frequencies[node.freq]:
                del self.frequencies[node.freq]
                if node.freq == self.min_freq:
                    self.min_freq += 1

            # Add to new frequency list
            node.freq += 1
            self.frequencies[node.freq][node.key] = node

    def make_key(args, kwargs, typed):
        try:
            key = args
            if kwargs:
                key += (frozenset(sorted(kwargs.items())),)
            if typed:
                key += tuple(type(arg) for arg in args)
                if kwargs:
                    key += tuple(type(v) for k, v in sorted(kwargs.items()))
            return hash(key)
        except TypeError:
            raise TypeError("Arguments to the cached function must be hashable")

    cache = LFUCache(maxsize)

    def decorator(func):
        def wrapper(*args, **kwargs):
            try:
                key = make_key(args, kwargs, typed)
                result = cache.get(key)
                if result is not None:
                    return result

                result = func(*args, **kwargs)
                cache.put(key, result)
                return result
            except TypeError as e:
                # If arguments are not hashable, bypass cache
                return func(*args, **kwargs)

        wrapper._cache = cache  # Expose cache for inspection/testing
        return wrapper

    return decorator
