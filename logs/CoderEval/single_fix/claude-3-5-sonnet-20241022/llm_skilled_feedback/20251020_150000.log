def initialize(self):
    """Create and initialize a new OCFL storage root."""
    try:
        # Create the root storage directory if it doesn't exist
        if not self.storage_root.exists('/'):
            self.storage_root.makedir('/', recreate=True)
            self.debug("Created OCFL storage root directory")

        # Initialize Namaste file identifiers for OCFL
        namaste = Namaste(self.storage_root)
        namaste.write()
        self.debug("Created Namaste files")

        # Create and write the OCFL storage root configuration
        root_config = {
            'type': 'https://ocfl.io/1.0/spec/',
            'digestAlgorithm': 'sha512',
            'contentDirectory': 'content'
        }

        # Ensure ocfl_layout.json exists in root
        with self.storage_root.open('ocfl_layout.json', 'w') as layout_file:
            dump(root_config, layout_file)
        self.debug("Created OCFL layout configuration")

    except Exception as e:
        raise StoreException(f"Failed to initialize OCFL storage root: {str(e)}")
