def is_local(host):
    if not host:
        return False
    
    # Consolidate all local identifiers into a single set for faster lookup
    local_identifiers = {
        'localhost', 'localhost.localdomain',
        '127.0.0.1', '::1',
        'localhost6', 'localhost6.localdomain6'
    }
    
    try:
        # Check if host is in the predefined set
        if host.lower() in local_identifiers:
            return True
            
        # Get the current machine's hostname
        import socket
        hostname = socket.gethostname()
        
        # Compare with current machine's hostname
        if host.lower() == hostname.lower():
            return True
            
        # Try to resolve the host address
        host_info = socket.gethostbyaddr(host)
        if host_info[0].lower() == hostname.lower():
            return True
            
        # Check if the resolved address is in local identifiers
        for addr in host_info[2]:
            if addr in local_identifiers:
                return True
                
        return False
        
    except (socket.error, socket.herror, socket.gaierror, AttributeError):
        # Handle any socket-related errors or invalid input types
        return False
