def _replace_url_args(url, url_args):
    """Replace any custom string URL items with values in args

    Args:
        url (str): URL string containing placeholder items in format '{key}:'
        url_args (dict): Dictionary containing key-value pairs where key matches
                        the placeholder in URL and value is the replacement string

    Returns:
        str: URL with placeholders replaced by corresponding values
    
    Example:
        url = "api/v1/{id}:/users/{type}:"
        url_args = {"id": "123", "type": "admin"}
        result = "api/v1/123/users/admin/"
    """
    if url and url_args:
        for key, value in url_args.items():
            # Replace '{key}:' pattern with 'value/'
            placeholder = f"{{{key}}}:"
            url = url.replace(placeholder, f"{value}/")
    return url
</repaired_code>

