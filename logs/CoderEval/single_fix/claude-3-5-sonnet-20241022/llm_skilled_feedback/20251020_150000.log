def _group_files_by_xml_filename(source: str, xmls: List[str], files: List[str]) -> Dict[str, Package]:
    result = {}
    for xml in xmls:
        xml_base = os.path.splitext(os.path.basename(xml))[0]
        package = Package()
        
        # Group files that match the XML basename
        matching_files = [file for file in files if xml_base in os.path.basename(file)]
        
        # Add files to the package
        for file in matching_files:
            if source:
                package.add_asset(file, source)
            else:
                package.add_asset(file)
                
        result[xml] = package
        
    return result
</repaired_code>

