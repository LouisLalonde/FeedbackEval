import os
import yaml
from typing import Dict, Any

def get_plugin_spec_flatten_dict(plugin_dir: str) -> Dict[str, Any]:
    """
    Creates a flat dict from the plugin spec

    :param plugin_dir: A path to the plugin's dir
    :return: A flatten dictionary contains the plugin's properties
    :raises: FileNotFoundError if plugin_dir doesn't exist
    :raises: yaml.YAMLError if YAML parsing fails
    """
    flattened_specs = {}
    
    if not os.path.exists(plugin_dir):
        raise FileNotFoundError(f"Plugin directory not found: {plugin_dir}")
    
    for root, _, files in os.walk(plugin_dir):
        for file in files:
            if not file.endswith(".yaml"):
                continue
                
            yaml_path = os.path.join(root, file)
            try:
                with open(yaml_path, "r", encoding='utf-8') as yaml_file:
                    try:
                        yaml_content = yaml.safe_load(yaml_file)
                        if yaml_content and isinstance(yaml_content, dict):
                            flattened_specs.update(flatten_dict(yaml_content))
                    except yaml.YAMLError as yaml_err:
                        print(f"Error parsing YAML file {yaml_path}: {yaml_err}")
                        continue
            except IOError as io_err:
                print(f"Error reading file {yaml_path}: {io_err}")
                continue
    
    return flattened_specs

def flatten_dict(data: Dict[str, Any], parent_key: str = '', sep: str = '.') -> Dict[str, Any]:
    """
    Flattens a nested dictionary into a single-level dictionary with dot-separated keys.
    
    :param data: The dictionary to flatten
    :param parent_key: The parent key for nested dictionaries
    :param sep: The separator to use between nested keys
    :return: A flattened dictionary
    """
    items = []
    for key, value in data.items():
        new_key = f"{parent_key}{sep}{key}" if parent_key else key
        
        if isinstance(value, dict):
            items.extend(flatten_dict(value, new_key, sep=sep).items())
        else:
            items.append((new_key, value))
    
    return dict(items)
