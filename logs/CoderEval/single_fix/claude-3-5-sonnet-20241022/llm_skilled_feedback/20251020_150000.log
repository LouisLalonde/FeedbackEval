def _resolve_string(matcher: dict) -> str:
    """
    Get the value from environment given a matcher containing a name and an optional default value in its group dict.
    If the variable is not defined in environment and no default value is provided, an Error is raised.
    """
    import os

    # Verify if 'name' exists in matcher dictionary
    if 'group' not in matcher or 'name' not in matcher['group']:
        raise ValueError("Matcher must contain 'name' in its group dictionary")

    # Get the variable name and default value if provided
    var_name = matcher['group']['name']
    default_value = matcher['group'].get('default')

    # Try to get the value from environment
    value = os.getenv(var_name)

    # Handle cases when variable is not in environment
    if value is None:
        if default_value is not None:
            return default_value
        else:
            raise ValueError(
                "Environment variable '{}' is not defined and no default value provided".format(var_name)
            )

    return value
</repaired_code>

