def get_nested_custom_and_control_args(self, args):
    control_args = {}
    nested_args = {}
    
    def parse_argument(arg_str):
        """Helper function to parse key-value pairs from arguments"""
        if "=" in arg_str:
            key, value = arg_str.split("=", 1)  # Split on first '=' only
            return key.strip(), value.strip()
        return arg_str.strip(), True

    def validate_key(key):
        """Validate if the key is properly formatted"""
        if not key:
            LOG.warning("Empty key detected in arguments")
            return False
        if not isinstance(key, Str):
            LOG.warning("Invalid key type: %s", type(key))
            return False
        return True

    # Iterate through arguments
    for arg in args:
        try:
            if arg.startswith("--"):
                # Double dash arguments are control args
                key, value = parse_argument(arg[2:])
                if validate_key(key):
                    if key in control_args:
                        LOG.warning("Duplicate control argument: %s", key)
                    control_args[key] = value
                    
            elif arg.startswith("-"):
                # Single dash arguments are also control args
                key, value = parse_argument(arg[1:])
                if validate_key(key):
                    if key in control_args:
                        LOG.warning("Duplicate control argument: %s", key)
                    control_args[key] = value
                    
            else:
                # No dash prefix means nested args
                key, value = parse_argument(arg)
                if validate_key(key):
                    if key in nested_args:
                        LOG.warning("Duplicate nested argument: %s", key)
                    if key in COMPLEX_TYPES:
                        LOG.warning("Using complex type as key: %s", key)
                    nested_args[key] = value
                    
        except Exception as e:
            LOG.warning("Error processing argument '%s': %s", arg, str(e))
            continue

    return control_args, nested_args
</repaired_code>

