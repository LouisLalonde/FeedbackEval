import textwrap
def oneline(script, separator=" && "):
    """
    Converts a multi-line script to a single line command.
    This is useful to run a single ssh command and pass a one line script.

    Args:
        script (str): The multi-line script to be converted to a single line.
                     Can contain indentation which will be normalized.
        separator (str, optional): The string used to join multiple lines.
                                 Defaults to " && ".

    Returns:
        str: A single line command with all lines joined by the separator and
             terminated with a semicolon. Returns empty string if input is empty.

    Example:
        >>> script = '''
            cd /tmp
            echo "hello"
            ls -la
        '''
        >>> oneline(script)
        'cd /tmp && echo "hello" && ls -la ;'
    """
    if not script:
        return ""
    
    # Normalize indentation and remove leading/trailing whitespace
    normalized = textwrap.dedent(script).strip()
    
    # Handle single line case
    if not normalized:
        return ""
    
    # Split into lines, filter out empty lines, and join with separator
    lines = [line.strip() for line in normalized.splitlines() if line.strip()]
    if not lines:
        return ""
        
    return separator.join(lines) + " ;"
</repaired_code>

