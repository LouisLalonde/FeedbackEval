def dehydrate_timedelta(value):
    """ Dehydrator for `timedelta` values.

    Converts a timedelta object into a Structure containing months, days, seconds,
    and nanoseconds components.

    :param value: The timedelta object to dehydrate
    :type value: timedelta
    :return: Structure object containing decomposed time components
    :rtype: Structure
    :raises TypeError: If input is not a timedelta object
    """
    from datetime import timedelta
    
    if not isinstance(value, timedelta):
        raise TypeError("Input must be a timedelta object")

    # Note: timedelta doesn't track months directly, so we set it to 0
    months = 0
    days = value.days
    seconds = value.seconds
    # Convert microseconds to nanoseconds (1 microsecond = 1000 nanoseconds)
    nanoseconds = 1000 * value.microseconds
    
    return Structure(b'E', months, days, seconds, nanoseconds)
</repaired_code>

