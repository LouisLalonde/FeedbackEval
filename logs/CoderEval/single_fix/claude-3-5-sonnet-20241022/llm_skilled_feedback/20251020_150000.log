    s2, spe, spe 1, spe pr, spe2, spe.2, spepr, supp 1, supp5 1, suppl,
    suppl 1, suppl 5 pr, suppl 12, suppl 1-2, suppl. 1
    """
    def clean_issue_text(text):
        if not text:
            return []
        return [s for s in text.strip().replace('.', '').split() if s]

    def is_supplement_indicator(text):
        return any(indicator in text.lower() for indicator in ['sup', 'spe'])

    def process_single_token(token):
        if token.isdigit():
            return token, None
        if is_supplement_indicator(token):
            return None, '0'
        if token.startswith('s') and token[1:].isdigit():
            return None, token[1:]
        return token, None

    def process_two_tokens(first, second):
        if is_supplement_indicator(first):
            return None, second
        if is_supplement_indicator(second):
            return first, '0'
        return ''.join([first, second]), None

    def process_three_tokens(first, second, third):
        if is_supplement_indicator(second):
            return first, third
        return ''.join([first, second, third]), None

    if not issue:
