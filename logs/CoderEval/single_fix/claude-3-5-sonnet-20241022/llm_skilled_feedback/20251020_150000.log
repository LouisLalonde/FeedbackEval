    class_dict = {}
    
    # Add field properties
    for field_name, field_type in fields.items():
        def make_property(fname):
            def getter(self):
                try:
                    return getattr(self, f"_{fname}")
                except AttributeError:
                    return None
                    
            def setter(self, value):
                setattr(self, f"_{fname}", value)
                
            return property(getter, setter)
            
        class_dict[field_name] = make_property(field_name)
    
    # Add SRID handling
    def get_srid(self):
        return self._srid if hasattr(self, '_srid') else None
        
    def set_srid(self, value):
        if value in srid_map:
            self._srid = value
        else:
            raise ValueError(f"Invalid SRID value: {value}")
            
    class_dict['srid'] = property(get_srid, set_srid)
    
    # Add initialization
    def __init__(self, **kwargs):
        for field in fields:
            setattr(self, f"_{field}", kwargs.get(field))
        self._srid = kwargs.get('srid')
    
    class_dict['__init__'] = __init__
    
    # Create the new type as a Point subclass
