def find_roots(
    graph: "Graph", prop: "URIRef", roots: Optional[Set["Node"]] = None
) -> Set["Node"]:
    """Find the roots in some sort of transitive hierarchy."""
    # Initialize roots to empty set if not provided
    if roots is None:
        roots = set()
    
    # Get all subjects and objects involved in the property relationship
    all_nodes = set()
    non_roots = set()
    
    # Find all nodes and potential non-roots
    for subject, obj in graph.subject_objects(prop):
        all_nodes.add(subject)
        all_nodes.add(obj)
        non_roots.add(subject)  # subject has a parent, so not a root
    
    # Roots are nodes that aren't children in any relationship
    candidate_roots = all_nodes - non_roots
    
    # If specific roots were provided, intersect with candidates
    if roots:
        candidate_roots = candidate_roots.intersection(roots)
        
    return candidate_roots
</repaired_code>

