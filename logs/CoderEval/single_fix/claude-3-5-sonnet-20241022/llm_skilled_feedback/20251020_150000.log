def to_csv(self, separator=",", header=None):
    """
    .. deprecated:: 0.5 in Lena 0.5 to_csv is not used.
          Iterables are converted to tables.
    """
    import warnings
    warnings.warn(
        "to_csv is deprecated since version 0.5. "
        "Use lena.output.ToCSV instead.",
        DeprecationWarning,
        stacklevel=2
    )

    output = ""

    # Validate header type if provided
    if header is not None:
        if not isinstance(header, str):
            try:
                header = str(header)
            except (TypeError, ValueError):
                raise TypeError("Header must be convertible to string")
        output += header + "\n"

    # Process each point in the graph
    try:
        for point in self:
            # Convert coordinates to string
            coordinates = separator.join(
                str(coord) for coord in point[:self.ndim]
            )
            # Convert values to string
            values = separator.join(
                str(value) for value in point[self.ndim:]
            )
            output += coordinates + separator + values + "\n"

    except (TypeError, AttributeError) as e:
        raise TypeError(f"Invalid point data format: {str(e)}")

    return output
</repaired_code>

