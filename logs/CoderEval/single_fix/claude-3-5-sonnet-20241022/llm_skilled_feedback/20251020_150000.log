from typing import List, Optional

def int_to_string(number: int, alphabet: List[str], padding: Optional[int] = None) -> str:
    # Validate inputs first
    if number < 0:
        raise ValueError("Number must be a non-negative integer")
    
    if padding is not None:
        if padding < 1:
            raise ValueError("Padding must be a positive integer")
    
    # Handle the special case of number being 0
    if number == 0:
        result = [alphabet[0]]
    else:
        result = []
        current_num = number
        while current_num:
            current_num, digit = divmod(current_num, len(alphabet))
            result.append(alphabet[digit])
        result = result[::-1]  # Reverse the list
    
    # Apply padding if specified
    if padding is not None:
        padding_needed = max(0, padding - len(result))
        result = [alphabet[0]] * padding_needed + result
    
    return ''.join(result)
</repaired_code>

