def validate_hierarchy(self, validate_objects=True, check_digests=True, show_warnings=False):
    num_objects = 0
    good_objects = 0
    
    try:
        # Open and validate the storage root
        root = ocfl_opendir()
        
        # Get all object paths in the storage root
        for obj_path in root.object_paths():
            num_objects += 1
            
            try:
                # Validate each object
                if validate_objects:
                    status = self.validate(obj_path, check_digests=check_digests)
                    if status:
                        good_objects += 1
                        if show_warnings:
                            print(f"Valid object: {obj_path}")
                    else:
                        if show_warnings:
                            print(f"Invalid object: {obj_path}")
                            print(self.status_str())
                
                # Get object info for additional validation
                obj_info = root.info(obj_path)
                if obj_info and not validate_objects:
                    good_objects += 1
                    
            except Exception as e:
                if show_warnings:
                    print(f"Error validating object {obj_path}: {str(e)}")
                continue
                
    except Exception as e:
        if show_warnings:
            print(f"Error accessing storage root: {str(e)}")
    
    return num_objects, good_objects
</repaired_code>

