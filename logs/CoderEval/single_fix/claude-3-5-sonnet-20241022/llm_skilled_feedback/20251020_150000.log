def parse_version(s: str) -> tuple[int, ...]:
    """Convert a comma-separated version string into a tuple of integers.
    
    Args:
        s (str): A version string with numbers separated by commas (e.g., "1,2,3")
        
    Returns:
        tuple[int, ...]: A tuple of integers representing version components
        
    Raises:
        ValueError: If the input string contains non-numeric values or invalid format
    """
    try:
        # Strip whitespace and split by comma
        parts = s.strip().split(',')
        # Convert each part to int, handling potential empty strings
        return tuple(int(p.strip()) for p in parts if p.strip())
    except ValueError as e:
        raise ValueError(f"Invalid version format. Expected comma-separated numbers, got: {s}") from e
