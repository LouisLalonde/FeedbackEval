def namesAndDescriptions(self, all=True): # pylint:disable=redefined-builtin
    """Return attribute names and descriptions defined by interface.

    Args:
        all (bool): If True, return only direct attributes. If False, include inherited attributes.

    Returns:
        list[tuple[str, str]]: List of tuples containing (attribute_name, description)
    """
    try:
        if all:
            # Convert items directly to a list for consistent return type
            return list(self.__attrs.items())

        # Initialize result dictionary
        result = {}
        
        # Handle inheritance - process bases in reverse order
        if hasattr(self, '__bases__'):
            for base in reversed(self.__bases__):
                if hasattr(base, 'namesAndDescriptions'):
                    # Convert items to dict before updating to handle various return types
                    result.update(dict(base.namesAndDescriptions(all)))

        # Add own attributes last to override any inherited ones
        if hasattr(self, '__attrs'):
            result.update(self.__attrs)

        # Return as list of tuples for consistency
        return list(result.items())
    except AttributeError:
        # Return empty list if required attributes are not found
        return []
</repaired_code>

