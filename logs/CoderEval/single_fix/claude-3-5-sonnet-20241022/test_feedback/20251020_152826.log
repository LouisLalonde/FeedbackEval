import datetime

def parse_frequency(frequency):
    if frequency is None or frequency == "always":
        return None
    
    parts = frequency.split()
    if len(parts) != 2:
        raise ValueError("Invalid frequency format")
    
    number = int(parts[0])
    timeunit = parts[1].lower().strip()
    
    # Handle both singular and plural forms
    if timeunit.endswith('s'):
        timeunit = timeunit[:-1]
    
    timeunit_map = {
        'day': 'days',
        'hour': 'hours',
        'minute': 'minutes',
        'second': 'seconds',
        'microsecond': 'microseconds',
        'millisecond': 'milliseconds',
        'week': 'weeks'
    }
    
    if timeunit not in timeunit_map:
        raise ValueError("Invalid timeunit")
        
    return datetime.timedelta(**{timeunit_map[timeunit]: number})
</repaired_code>

