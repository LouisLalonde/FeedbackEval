def deep_merge_nodes(nodes):
    if not nodes:
        return []
    
    result = {}
    for node in nodes:
        key, value = node
        key_value = key.value
        
        if key_value in result:
            existing_value = result[key_value][1]
            if isinstance(existing_value, MappingNode) and isinstance(value, MappingNode):
                # Merge two MappingNodes
                merged_values = {}
                # Process existing values
                for k, v in existing_value.value:
                    merged_values[k.value] = (k, v)
                # Process and merge new values
                for k, v in value.value:
                    merged_values[k.value] = (k, v)
                # Create new MappingNode with merged values
                result[key_value] = (key, MappingNode(
                    tag='tag:yaml.org,2002:map',
                    value=list(merged_values.values())
                ))
            else:
                # For non-MappingNodes, last value wins
                result[key_value] = (key, value)
        else:
            result[key_value] = (key, value)
    
    return list(result.values())
</repaired_code>

