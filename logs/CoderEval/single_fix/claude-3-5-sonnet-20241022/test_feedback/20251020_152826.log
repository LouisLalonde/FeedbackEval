        deprecated_args = get_deprecated_args()
        
        # Check CLI arguments for deprecation
        for arg_name, arg_value in cli_args.items():
            if arg_name in deprecated_args:
                LOG.warning(
                    format("Argument '{}' is deprecated. {}",
                          arg_name,
                          deprecated_args[arg_name])
                )
                
        # Check answer file arguments for deprecation
        for arg_name, arg_value in answer_file_args.items():
            if arg_name in deprecated_args:
                LOG.warning(
                    format("Argument '{}' from answer file is deprecated. {}",
                          arg_name,
                          deprecated_args[arg_name])
                )
                
        # Raise exception if deprecated arguments are used
        deprecated_in_use = set(cli_args.keys()).union(set(answer_file_args.keys())).intersection(set(deprecated_args.keys()))
        if deprecated_in_use:
            raise IRDeprecationException(
                "The following arguments are deprecated: {}".format(
                    ", ".join(deprecated_in_use)
                )
            )

    generate_code(cli_args, answer_file_args)
