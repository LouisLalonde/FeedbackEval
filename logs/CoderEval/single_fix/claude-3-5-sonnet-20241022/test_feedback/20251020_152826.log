from functools import update_wrapper

def cached(cache, key=hashkey, lock=None):
    def decorator(func):
        def wrapper(*args, **kwargs):
            k = key(*args, **kwargs)
            
            def get_value():
                if k in cache:
                    return cache[k]
                result = func(*args, **kwargs)
                cache[k] = result
                return result
            
            if lock:
                with lock:
                    return get_value()
            return get_value()
            
        update_wrapper(wrapper, func)
        return wrapper
    return decorator
