<repaired_code>
def extostr(cls, e, max_level=30, max_path_level=5):
    """
    Format an exception with stack trace details
    """
    try:
        # Get exception info
        exc_type, exc_value, exc_traceback = sys.exc_info()
        if exc_traceback is None and hasattr(e, '__traceback__'):
            exc_traceback = e.__traceback__

        # Build the exception string
        exception_str = []
        
        # Add exception type and message
        exception_str.append(f"Exception: {repr(e)}")
        
        # Get stack trace
        if exc_traceback:
            tb_list = list(reversed(list(extract_tb(exc_traceback, limit=max_level))))
            
            # Format each stack frame
            for frame in tb_list[:max_level]:
                # Split path and keep last max_path_level components
                path_parts = frame.filename.rsplit('/', max_path_level)
                short_path = '/'.join(path_parts[-max_path_level:])
                
                # Add formatted frame info
                frame_str = f"  File '{short_path}', line {frame.lineno}, in {frame.name}"
                exception_str.append(frame_str)
                if frame.line:
                    exception_str.append(f"    {frame.line.strip()}")
        
        return '\n'.join(exception_str)
    except Exception as format_ex:
        # Fallback to simple string conversion if formatting fails
        logger.warning(f"Exception during exception formatting: {format_ex}")
        return str(e)
</repaired_code>

