def namesAndDescriptions(self, all=True): # pylint:disable=redefined-builtin
    """Return attribute names and descriptions defined by interface."""
    r = {}
    
    if all:
        # Get attributes from base interfaces first
        for base in self.__bases__[::-1]:
            r.update(dict(base.namesAndDescriptions(all=True)))
        # Then update with own attributes
        r.update(self.__attrs)
    else:
        # When all=False, only return directly defined attributes
        r.update(self.__attrs)
    
    return r.items()
