    # Create registry if it doesn't exist
    if not hasattr(register_vcs_handler, '_registry'):
        register_vcs_handler._registry = {}
    
    if vcs not in register_vcs_handler._registry:
        register_vcs_handler._registry[vcs] = {}

    def decorator(func):
        def wrapper(*args, **kwargs):
            return func(*args, **kwargs)
        
        # Store the handler in the registry
        register_vcs_handler._registry[vcs][method] = wrapper
        return wrapper

    return decorator
