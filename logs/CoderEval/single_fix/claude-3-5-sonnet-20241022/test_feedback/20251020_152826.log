def lfu_cache(maxsize=128, typed=False):
    def decorator(func):
        cache = {}
        hits = {}
        
        def make_key(args, kwargs):
            if typed:
                key = (tuple(args), tuple(sorted(kwargs.items())))
            else:
                key = (tuple(str(arg) for arg in args), 
                      tuple(sorted((k, str(v)) for k, v in kwargs.items())))
            return hash(key)

        def wrapper(*args, **kwargs):
            key = make_key(args, kwargs)
            
            if key in cache:
                hits[key] += 1
                return cache[key]
                
            result = func(*args, **kwargs)
            
            if maxsize is not None and len(cache) >= maxsize:
                # Find and remove least frequently used item
                min_hits = min(hits.values())
                lfu_keys = [k for k, v in hits.items() if v == min_hits]
                lfu_key = lfu_keys[0]  # Remove the first LFU item
                del cache[lfu_key]
                del hits[lfu_key]
                
            cache[key] = result
            hits[key] = 1
            
            return result
            
        wrapper.cache = cache
        wrapper.hits = hits
        return wrapper
        
    return decorator
</repaired_code>

