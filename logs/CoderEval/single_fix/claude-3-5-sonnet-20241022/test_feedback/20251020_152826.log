def process_text_links(text):
    """
    Process links in text, adding some attributes and linkifying textual links.
    """
    if not text:
        return text
    
    def link_callback(attrs, new=False):
        # Add target="_blank" and rel="noopener" to all links
        attrs['target'] = '_blank'
        attrs['rel'] = 'noopener'
        return attrs

    # First handle any explicit links that start with http/https
    processed_text = text
    
    # Create callbacks object for link processing
    callbacks = {
        'link': link_callback
    }
    
    # Linkify the text - converts text URLs to actual links
    # and processes them through the callback
    processed_text = linkify(
        processed_text,
        callbacks=callbacks,
    )
    
    return processed_text
</repaired_code>

