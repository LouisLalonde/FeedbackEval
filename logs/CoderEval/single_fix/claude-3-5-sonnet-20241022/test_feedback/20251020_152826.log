<repaired_code>
def is_local(host):
    import socket
    
    # Standard localhost entries
    localhost = ['localhost', '127.0.0.1']
    local_ip = ['127.0.0.1', '::1']
    local_domain = ['localhost.localdomain', 'localhost']
    
    # Get the current machine's hostname and IP
    try:
        # Get hostname and normalize to lowercase
        hostname = socket.gethostname().lower()
        # Get fully qualified domain name
        fqdn = socket.getfqdn().lower()
        # Get local IP addresses
        host_ip = socket.gethostbyname(hostname)
        
        # Add current machine's identifiers to local lists
        localhost.append(hostname)
        local_domain.append(fqdn)
        local_ip.append(host_ip)
        
        # Normalize input host to lowercase
        host = host.lower()
        
        # Check if host matches any local identifier
        if (host in localhost or 
            host in local_ip or 
            host in local_domain or 
            host == hostname or 
            host == fqdn):
            return True
            
        # Try to resolve host to IP and check if it's local
        try:
            host_addr = socket.gethostbyname(host)
            if host_addr in local_ip:
                return True
        except socket.error:
            pass
            
    except socket.error:
        # Fall back to basic checks if hostname resolution fails
        if host in localhost or host in local_ip or host in local_domain:
            return True
            
    return False
</repaired_code>

