import argparse
from collections import OrderedDict

def parse_subparser_arguments(unparsed_arguments, subparsers):
    parser = argparse.ArgumentParser()
    subparser_dict = OrderedDict()
    
    # Create subparsers for each parser in the input dict
    for subparser_name, subparser in subparsers.items():
        # Get all the actions/arguments from the original subparser
        subparser_dict[subparser_name] = parser.add_subparsers(dest=subparser_name)
        new_parser = subparser_dict[subparser_name].add_parser(subparser_name)
        
        # Copy all arguments from original subparser to new parser
        for action in subparser._actions:
            if not isinstance(action, argparse._SubParsersAction):
                new_parser.add_argument(*action.option_strings, 
                                      dest=action.dest,
                                      default=action.default,
                                      help=action.help,
                                      type=action.type,
                                      choices=action.choices)
    
    parsed_args = {}
    remaining_args = list(unparsed_arguments)  # Create a copy of arguments
    
    # Try parsing with each subparser
    for subparser_name in subparser_dict.keys():
        if remaining_args:
            try:
                parsed, unknown = parser.parse_known_args(remaining_args)
                if getattr(parsed, subparser_name, None) is not None:
                    parsed_args[subparser_name] = parsed
                    # Update remaining args to only include unknown arguments
                    remaining_args = unknown
            except argparse.ArgumentError:
                continue
    
    return parsed_args, remaining_args
