def _eval_file(prefix, file_path):
    """
    Evaluate file type and return appropriate metadata dictionary.
    """
    if not file_path or not prefix:
        return None
        
    # Skip XML files and files not matching prefix
    if file_path.endswith(".xml") or not os.path.basename(file_path).startswith(prefix):
        return None
        
    file_type = os.path.splitext(file_path)[1].lower()
    
    if file_type == ".pdf":
        return {
            "component_id": file_path,
            "file_path": file_path,
            "ftype": "rendition"
        }
    else:
        return {
            "component_id": file_path,
            "file_path": file_path,
            "ftype": "asset"
        }
