from typing import List, Dict
from zipfile import is_zipfile, ZipFile
from file_utils import xml_files_list_from_zipfile, files_list_from_zipfile

def _explore_zipfile(zip_path: str) -> Dict[str, List[str]]:
    def _group_files_by_xml_filename(file_list: List[str]) -> List[List[str]]:
        groups = {}
        for filename in file_list:
            if filename.endswith('.xml'):
                base_name = filename.replace('.xml', '')
                groups[base_name] = [filename]
                
                # Group related files with the same base name
                for other_file in file_list:
                    if other_file != filename and other_file.startswith(base_name):
                        groups[base_name].append(other_file)
        
        return [group for group in groups.values()]

    if not is_zipfile(zip_path):
        return {}

    # Get list of all files in the zip
    all_files = files_list_from_zipfile(zip_path)
    if not all_files:
        return {}

    # Get XML files from zip
    xml_files = xml_files_list_from_zipfile(zip_path)
    if not xml_files:
        return {}

    # Group files by XML basename
    grouped_files = _group_files_by_xml_filename(all_files)
    
    # Create return dictionary
    result = {}
    for group in grouped_files:
        if group:  # Ensure group is not empty
            xml_file = next((f for f in group if f.endswith('.xml')), None)
            if xml_file:
                base_name = xml_file.replace('.xml', '')
                result[base_name] = group

    return result
</repaired_code>

