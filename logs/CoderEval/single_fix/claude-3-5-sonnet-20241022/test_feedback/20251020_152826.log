<repaired_code>
def unit_of_work(metadata=None, timeout=None):
    if metadata is not None and not isinstance(metadata, dict):
        raise TypeError("metadata must be a dictionary or None")
    if timeout is not None:
        if not isinstance(timeout, (int, float)):
            raise TypeError("timeout must be a number or None")
        if timeout < 0:
            raise ValueError("timeout cannot be negative")
            
    def decorator(func):
        def wrapper(*args, **kwargs):
            # Store the original function's metadata
            if hasattr(func, "__name__"):
                wrapper.__name__ = func.__name__
            if hasattr(func, "__doc__"):
                wrapper.__doc__ = func.__doc__
                
            # Execute the wrapped function with metadata and timeout
            try:
                if len(args) > 0:
                    tx = args[0]
                    if metadata:
                        tx.run("CALL dbms.setTXMetaData($metadata)", 
                              metadata=metadata)
                    if timeout is not None:
                        tx.run("CALL dbms.setTransactionTimeout($timeout)", 
                              timeout=int(timeout * 1000))  # Convert to milliseconds
                return func(*args, **kwargs)
            except Exception as e:
                raise e

        return wrapper
    return decorator
</repaired_code>

