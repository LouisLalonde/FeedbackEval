def bash_completion():
    parsers = make_parsers()
    
    completion_script = [
        '# Bash completion for the borgmatic command.',
        '_borgmatic()',
        '{',
        '    local cur prev opts',
        '    COMPREPLY=()',
        '    cur="${COMP_WORDS[COMP_CWORD]}"',
        '    prev="${COMP_WORDS[COMP_CWORD-1]}"',
        '',
        '    # All available options',
        '    opts="'
    ]

    # Collect all options from parsers
    all_options = set()
    for parser_name, parser in parsers.items():
        for action in parser._actions:
            if hasattr(action, 'option_strings'):
                all_options.update(action.option_strings)
    
    # Add collected options to completion script
    completion_script.append(' '.join(sorted(all_options)))
    completion_script.extend([
        '"',
        '',
        '    if [[ ${cur} == -* ]] ; then',
        '        COMPREPLY=( $(compgen -W "${opts}" -- ${cur}) )',
        '        return 0',
        '    fi',
        '}',
        '',
        'complete -F _borgmatic borgmatic'
    ])

    return '\n'.join(completion_script)
</repaired_code>

