<repaired_code>
def deep_merge_nodes(nodes):
    result = []
    merged_keys = {}

    # First pass: collect all keys and their values
    for key_node, value_node in nodes:
        key = key_node.value
        
        if key not in merged_keys:
            merged_keys[key] = (key_node, value_node)
        else:
            # If both current and existing values are MappingNodes, merge them
            if (isinstance(value_node, MappingNode) and 
                isinstance(merged_keys[key][1], MappingNode)):
                
                # Recursively merge the nested mapping nodes
                merged_value = deep_merge_nodes(
                    merged_keys[key][1].value + value_node.value
                )
                
                # Create new MappingNode with merged values
                merged_keys[key] = (
                    key_node,
                    MappingNode(
                        tag='tag:yaml.org,2002:map',
                        value=merged_value
                    )
                )
            else:
                # For non-mapping nodes or when one is not a mapping,
                # take the latest value
                merged_keys[key] = (key_node, value_node)

    # Convert merged dictionary back to list of tuples
    for key_node, value_node in merged_keys.values():
        result.append((key_node, value_node))

    return result
</repaired_code>

