def size_to_bytes(size: str) -> int:
    units = {'B': 1, 'K': 1000, 'M': 1000**2, 'G': 1000**3, 'T': 1000**4}
    
    # Handle case with no unit (just number)
    if size.isdigit():
        return int(size)
    
    # Get magnitude and unit
    magnitude = int(size[:-1])
    unit = size[-1].upper()
    
    # Convert to bytes using the units dictionary
    if unit in units:
        return magnitude * units[unit]
    
    # If no valid unit found, treat as bytes
    return magnitude
</repaired_code>

