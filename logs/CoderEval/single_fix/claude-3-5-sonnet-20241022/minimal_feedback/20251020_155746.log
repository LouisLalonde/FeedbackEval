import re
def get_pattern(pattern, strip=False):
    """
    This method converts the given string to regex pattern
    
    Args:
        pattern: Input string or compiled regex pattern
        strip: Boolean flag to strip whitespace from pattern string
    
    Returns:
        re.Pattern: Compiled regex pattern
        
    Raises:
        TypeError: If pattern is None or not str/Pattern
        re.error: If pattern is invalid regex
    """
    if pattern is None:
        raise TypeError("Pattern cannot be None")
        
    if isinstance(pattern, re.Pattern):
        return pattern

    if not isinstance(pattern, str):
        raise TypeError("Pattern must be string or compiled regex")

    if strip:
        if not isinstance(strip, bool):
            raise TypeError("Strip must be boolean")
        pattern = pattern.strip()

    try:
        return re.compile(pattern + '$')
    except re.error as e:
        raise re.error(f"Invalid regex pattern: {str(e)}")
</repaired_code>

