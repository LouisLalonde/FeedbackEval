def validate_version_inventories(self, version_dirs):
    different_digests = set()
    previous_inventory_digests = None

    for version_dir in version_dirs:
        inventory_path = os.path.join(version_dir, "inventory.xml")
        root_inventory_path = os.path.join("root", "inventory.xml")
        
        # Check if inventory file exists for the current version
        if not os.path.exists(inventory_path):
            self.error(f"Missing inventory file in version directory: {version_dir}")
            return False
        
        # Get content digests for current version
        inventory_digests = get_content_digests(inventory_path)
        root_inventory_digests = get_content_digests(root_inventory_path)
        
        # Compare with root inventory and store different digests
        if inventory_digests != root_inventory_digests:
            diff_keys = set(inventory_digests.keys()) ^ set(root_inventory_digests.keys())
            different_digests.update(diff_keys)
            self.warning(f"Content digests differ in version {version_dir}")
        
        # Validate against previous version's inventory if exists
        if previous_inventory_digests is not None:
            if not self.validate_as_prior_version(previous_inventory_digests, inventory_digests):
                self.error(f"Invalid version sequence in {version_dir}")
                return False
        
        previous_inventory_digests = inventory_digests
    
    # Store different digests for content validation
    self.different_digests = sorted(list(different_digests))
    return True
</repaired_code>

