def bash_completion():
    """Return a bash completion script for the borgmatic command."""
    parsers = make_parsers()
    
    commands = []
    flags = set()
    
    # Collect all commands and flags from parsers
    for parser_name, parser in parsers.items():
        if parser_name != 'common':
            commands.append(parser_name)
        
        for flag in parser_flags(parser):
            flags.add(flag)
    
    # Build the completion script
    script = [
        '_borgmatic()',
        '{',
        '    local cur prev opts',
        '    COMPREPLY=()',
        '    cur="${COMP_WORDS[COMP_CWORD]}"',
        '    prev="${COMP_WORDS[COMP_CWORD-1]}"',
        '    opts="--help -h ' + ' '.join(sorted(flags)) + '"',
        '    commands="' + ' '.join(sorted(commands)) + '"',
        '',
        '    if [[ ${cur} == -* ]] ; then',
        '        COMPREPLY=( $(compgen -W "${opts}" -- ${cur}) )',
        '        return 0',
        '    fi',
        '',
        '    if [[ ${COMP_CWORD} -eq 1 ]] ; then',
        '        COMPREPLY=( $(compgen -W "${commands}" -- ${cur}) )',
        '        return 0',
        '    fi',
        '}',
        '',
        'complete -F _borgmatic borgmatic',
    ]
    
    return '\n'.join(script)
