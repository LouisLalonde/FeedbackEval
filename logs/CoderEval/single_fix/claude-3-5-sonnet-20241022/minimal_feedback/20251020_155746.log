def _group_files_by_xml_filename(xml_filename: str, files: List[str]) -> Dict[str, List[str]]:
    from os.path import basename, splitext
    
    xml_base = splitext(basename(xml_filename))[0]
    result = {}
    
    for file in files:
        file_base = splitext(basename(file))[0]
        if file_base.startswith(xml_base):
            result.setdefault(xml_filename, []).append(file)
    
    return result
</repaired_code>

