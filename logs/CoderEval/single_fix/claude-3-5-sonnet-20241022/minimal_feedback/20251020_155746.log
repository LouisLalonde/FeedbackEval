def strip_root(path, root):
    """Remove root from path, throw exception on failure."""
    root = root.rstrip()
    if os.path.commonprefix([path, root]) == root:
        return os.path.relpath(path, start=root)
    raise Exception('Path %s is not in root %s' % (path, root))
