def deep_merge_nodes(nodes):
    """Deep merge node values corresponding to duplicate keys and return the result."""
    replaced_nodes = {}
    for a_key, a_value in nodes:
        for b_key, b_value in nodes:
            if (a_key, a_value) in replaced_nodes or (b_key, b_value) in replaced_nodes:
                continue
            
            if (a_key.tag == b_key.tag and a_key.value == b_key.value and a_value != b_value):
                replaced_nodes[(a_key, a_value)] = DELETED_NODE
                
                if isinstance(b_value, ruamel.yaml.nodes.MappingNode):
                    # Merge mapping nodes by recursively calling deep_merge_nodes on their values
                    merged_values = []
                    if isinstance(a_value, ruamel.yaml.nodes.MappingNode):
                        merged_values = deep_merge_nodes(a_value.value + b_value.value)
                    else:
                        merged_values = b_value.value
                        
                    replaced_nodes[(b_key, b_value)] = (
                        b_key,
                        ruamel.yaml.nodes.MappingNode(
                            tag=b_value.tag,
                            value=merged_values,
                            start_mark=b_value.start_mark,
                            end_mark=b_value.end_mark,
                            flow_style=b_value.flow_style,
                            comment=b_value.comment,
                            anchor=b_value.anchor
                        )
                    )
                elif isinstance(b_value, ruamel.yaml.nodes.SequenceNode):
                    # Concatenate sequence nodes
                    replaced_nodes[(b_key, b_value)] = (
                        b_key,
                        ruamel.yaml.nodes.SequenceNode(
                            tag=b_value.tag,
                            value=a_value.value + b_value.value,
                            start_mark=b_value.start_mark,
                            end_mark=b_value.end_mark,
                            flow_style=b_value.flow_style,
                            comment=b_value.comment,
                            anchor=b_value.anchor
                        )
                    )
                else:
                    # For non-mapping/sequence nodes, keep the last value
                    replaced_nodes[(b_key, b_value)] = (b_key, b_value)

    return [replaced_nodes.get(node, node) for node in nodes if replaced_nodes.get(node, node) != DELETED_NODE]
