<repaired_code>
class Time:
    @classmethod
    def from_ticks(cls, ticks, tz=None):
        """
        Create a time from ticks (nanoseconds since midnight).

        :param ticks: nanoseconds since midnight
        :type ticks: int
        :param tz: optional timezone
        :type tz: datetime.tzinfo

        :rtype: Time

        :raises ValueError: if ticks is out of bounds
            (0 <= ticks < 86400000000000)
        """
        if not isinstance(ticks, int):
            raise TypeError("ticks must be an integer")
            
        if ticks < 0 or ticks >= 86400000000000:
            raise ValueError("ticks must be between 0 and 86400000000000")

        # Calculate hours, minutes, seconds and nanoseconds
        remaining_ticks = ticks
        hours, remaining_ticks = divmod(remaining_ticks, 3600000000000)
        minutes, remaining_ticks = divmod(remaining_ticks, 60000000000)
        seconds, nanoseconds = divmod(remaining_ticks, 1000000000)

        # Create new Time instance
        time = cls.__new__(cls)
        time.hour = int(hours)
        time.minute = int(minutes)
        time.second = int(seconds)
        time.nanosecond = int(nanoseconds)
        time.ticks = ticks
        
        return time
</repaired_code>

