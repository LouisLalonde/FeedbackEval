            code_block = not code_block
            if current_word and not code_block:  # Handle word before code block
                tags.add(current_word)
                replaced_text += replacer(current_word)
                current_word = ""
            replaced_text += char
        elif code_block:
            replaced_text += char
        elif char.isalpha() or char.isdigit() or char == '_':
            current_word += char
        else:
            if current_word:
                tags.add(current_word)
                replaced_text += replacer(current_word)
                current_word = ""
            replaced_text += char
    
    if current_word:  # Handle word at end of text
        tags.add(current_word)
        replaced_text += replacer(current_word)
    
    return tags, replaced_text
