def _extract_number_and_supplment_from_issue_element(issue):
    """
    Extrai do conteúdo de <issue>xxxx</issue>, os valores number e suppl.
    Valores possíveis
    5 (suppl), 5 Suppl, 5 Suppl 1, 5 spe, 5 suppl, 5 suppl 1, 5 suppl. 1,
    25 Suppl 1, 2-5 suppl 1, 2spe, Spe, Supl. 1, Suppl, Suppl 12,
    s2, spe, spe 1, spe pr, spe2, spe.2, spepr, supp 1, supp5 1, suppl,
    suppl 1, suppl 5 pr, suppl 12, suppl 1-2, suppl. 1
    """
    if not issue:
        return None, None

    # Clean and normalize the input
    issue = issue.strip().replace('.', '')
    splitted = [s for s in issue.split() if s]
    
    # Normalize special cases
    splitted = [('spe' if 'spe' in s.lower() or 
                (s.isalpha() and 'sup' in s.lower()) else s) 
                for s in splitted]

    # Case 1: Single element
    if len(splitted) == 1:
        issue = splitted[0]
        if issue.isdigit():
            return issue, None
        if 'sup' in issue.lower():
            return None, '0'
        if issue.startswith('s'):
            if issue[1:].isdigit():
                return None, issue[1:]
        return issue, None

    # Case 2: Two elements
    if len(splitted) == 2:
        if 'sup' in splitted[0].lower():
            return None, splitted[1]
        if 'sup' in splitted[1].lower():
            return splitted[0], '0'
        if splitted[0].isdigit() and splitted[1].isdigit():
            return ''.join(splitted), None
        return splitted[0], splitted[1]

    # Case 3: Three elements
    if len(splitted) == 3:
        if 'sup' in splitted[1].lower():
            return splitted[0], splitted[2]
        if all(s.isdigit() for s in splitted):
            return ''.join(splitted), None

    # Default case: join all elements if they can't be parsed
    return ''.join(splitted), None
