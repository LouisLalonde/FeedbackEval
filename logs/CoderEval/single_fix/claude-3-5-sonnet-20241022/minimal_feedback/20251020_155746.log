from functools import wraps

def tzname_in_python2(namefunc):
    """Decorator to change unicode output into bytestrings in Python 2"""
    @wraps(namefunc)
    def wrapper(*args, **kwargs):
        result = namefunc(*args, **kwargs)
        if result is not None and isinstance(result, unicode):
            return result.encode('utf-8')
        return result
    return wrapper
</repaired_code>

