import argparse
from collections import OrderedDict

def parse_subparser_arguments(unparsed_arguments, subparsers):
    parser = argparse.ArgumentParser()
    subparser_dict = OrderedDict()
    
    # Create subparsers for each parser in the input
    for subparser_name, subparser in subparsers.items():
        subparser_dict[subparser_name] = parser.add_subparsers(dest=subparser_name)
        subparser.add_parser_arguments(subparser_dict[subparser_name])
    
    parsed_args = {}
    remaining_args = list(unparsed_arguments)  # Create a copy to modify
    
    # Try each subparser against the arguments
    for subparser_name, subparser in subparser_dict.items():
        if not remaining_args:
            break
            
        try:
            # Use parse_known_args instead of parse_args to handle partial parsing
            parsed, unknown = subparser.parse_known_args(remaining_args)
            if vars(parsed).get(subparser_name) is not None:
                parsed_args[subparser_name] = parsed
                # Update remaining args to only include unknown arguments
                remaining_args = unknown
        except (argparse.ArgumentError, SystemExit):
            # Continue if parsing fails for this subparser
            continue
    
    return parsed_args, remaining_args
