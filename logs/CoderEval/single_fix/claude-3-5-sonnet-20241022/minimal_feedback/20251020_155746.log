import os


def is_gitbash():
    """
    returns True if you run in a Windows gitbash

    :return: True if gitbash
    """
    try:
        # Check both MSYSTEM and TERM environment variables which are more reliable
        msystem = os.environ.get('MSYSTEM', '')
        term = os.environ.get('TERM', '')
        
        # GitBash typically sets MSYSTEM to MINGW64/MINGW32 and TERM to xterm
        return 'MINGW' in msystem and 'xterm' in term
    except KeyError:
        return False
