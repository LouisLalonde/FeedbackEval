def is_local(host):
    import socket

    # Standard localhost identifiers
    localhost = {'localhost', '127.0.0.1', '::1', 'localhost.localdomain'}
    
    try:
        # Get the actual hostname of the machine
        hostname = socket.gethostname()
        # Get all IP addresses for this hostname
        local_ips = set()
        for family in (socket.AF_INET, socket.AF_INET6):
            try:
                info = socket.getaddrinfo(hostname, None, family, socket.SOCK_STREAM)
                local_ips.update(addr[4][0] for addr in info)
            except socket.error:
                continue
        
        # Add hostname to localhost set
        localhost.add(hostname)
        localhost.update(local_ips)
        
        # Try to resolve the provided host
        try:
            host_ip = socket.gethostbyaddr(host)[2][0]
            return host.lower() in localhost or host_ip in localhost
        except socket.error:
            return host.lower() in localhost
            
    except socket.error:
        # Fallback to basic comparison if socket operations fail
        return host.lower() in localhost

</repaired_code>

