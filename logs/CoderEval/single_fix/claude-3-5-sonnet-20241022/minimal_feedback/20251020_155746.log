import argparse
from collections import OrderedDict

def parse_subparser_arguments(unparsed_arguments, subparsers):
    parser = argparse.ArgumentParser()
    subparser_results = OrderedDict()
    remaining_arguments = list(unparsed_arguments)

    # Try each subparser with all remaining arguments
    for subparser_name, subparser in subparsers.items():
        try:
            # Use parse_known_args instead of parse_args to handle unknown arguments
            parsed_args, unknown_args = subparser.parse_known_args(remaining_arguments)
            
            # Only store results if some arguments were actually parsed
            if vars(parsed_args):
                subparser_results[subparser_name] = parsed_args
            
            # Update remaining arguments to only those that weren't parsed
            remaining_arguments = unknown_args
            
        except argparse.ArgumentError:
            continue

    return subparser_results, remaining_arguments
